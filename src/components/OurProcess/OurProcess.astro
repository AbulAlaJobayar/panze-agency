---
import LinkButton from "../ui/LinkButton.astro";
import Stepper from "./Stepper";
import sectionIcon from "@/assets/sectionIcon/networkIcon.svg";
const { ourProcess } = Astro.props;

const {
  title,
  subTitle,
  description,
  buttonText,
  buttonLink,
  ourPocessIcon,
  steps,
} = ourProcess.frontmatter;
// Sanitize the steps data
const data = {
  title,
  subTitle,
  description,
  buttonText,
  buttonLink,
  ourPocessIcon,
};
const sanitizedSteps = Array.isArray(steps)
  ? steps
      .map((step: any) => ({
        title: step.title?.trim() || "",
        description: step.description?.trim() || "",
        image: step.image?.trim() || "",
        imageAlt: step.imageAlt?.trim() || "",
        points: Array.isArray(step.points)
          ? step.points.map((point: string) => point.trim())
          : [],
      }))
      .filter(
        (step: any) => step.title && step.description && step.points.length > 0,
      )
  : [];
---

<section>
  <!-- large device -->
  <div class="hidden lg:block">
    <Stepper client:load data={data} steps={sanitizedSteps} />
  </div>

  <!-- smallDevices -->
  <div class="block lg:hidden mb-20">
    <div class="flex flex-col">
      <!-- Left Side - Fixed width with white background -->
      <div class="px-8 w-full mt-20 mb-10 shrink-0 bg-white">
        <div class="process-badge flex items-center gap-2 mb-6">
          <img
            src={sectionIcon.src}
            alt="icon"
            class="w-4 h-4 md:w-auto md:h-auto"
          />
          <h6
            class="process-title font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary"
          >
            {data.title}
          </h6>
        </div>
        <p
          class="process-subtitle font-commissioner font-semiboldtext-[24px] leading-[110%] tracking-[-4%] uppercase mb-8"
        >
          {data.subTitle}
        </p>
        <p
          class="process-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] mb-10"
        >
          {data.description}
        </p>
        <div class="process-button">
          <LinkButton href={buttonLink} text={buttonText} />
        </div>
      </div>
    </div>

    <!-- bottom component  -->
    <div>
      {
        steps.map((step: any, index: any) => (
          <div class="mx-8">
            <div
              class:list={[
                "step-card mx-auto py-12 px-15 border border-black/20 grid md:grid-cols-2 gap-2 items-center justify-center",
                index !== 0 && "border-t-0",
              ]}
            >
              {/* Image Section */}
              <div class="step-image mb-10 h-80 w-64.75 rounded-[180px] bg-gray-100 overflow-hidden relative">
                <img
                  src={step.image}
                  alt={step.imageAlt}
                  class="absolute inset-0 w-full h-full object-cover"
                />
              </div>
              {/* Content Section */}

              <div class="step-content">
                <h3 class="font-commissioner font-semibold text-[22px] uppercase mb-4">
                  {step.title}{" "}
                </h3>
                <p class="font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] mb-9">
                  {step.description}
                </p>
                <ul>
                  {step.points.map((item: any) => (
                    <li class="flex items-center gap-3">
                      <span class="text-[#301C1B] mt-1">-</span>
                      <span class="font-dm-mono font-normal text-[14px] text-[#301C1B] leading-[150%] tracking-[-4%]">
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ----------------------------
  // Header Animation
  // ----------------------------
  const headerTl = gsap.timeline({
    scrollTrigger: {
      trigger: ".process-header",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  headerTl
    // Whole Left Panel
    .from(".process-header", {
      x: -100,
      opacity: 0,
      duration: 1,
      ease: "expo.out",
    })

    // Icon
    .from(
      ".process-badge img",
      {
        scale: 0.3,
        rotate: 90,
        opacity: 0,
        duration: 0.8,
        ease: "back.out(2)",
      },
      "-=0.5",
    )

    // Small Title
    .from(
      ".process-title",
      {
        x: -20,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
      },
      "-=0.5",
    )

    // Main Subtitle
    .from(
      ".process-subtitle",
      {
        y: 80,
        opacity: 0,
        duration: 1,
        ease: "expo.out",
      },
      "-=0.3",
    )

    // Description
    .from(
      ".process-description",
      {
        y: 30,
        opacity: 0,
        duration: 0.7,
        ease: "power2.out",
      },
      "-=0.7",
    )

    // Button
    .from(
      ".process-button",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
      },
      "-=0.5",
    );

  // ----------------------------
  // Step Cards Animation
  // ----------------------------
  gsap.utils.toArray(".step-card").forEach((card: any, index) => {
    const image = card.querySelector(".step-image");
    const content = card.querySelector(".step-content");
    const title = card.querySelector("h3");
    const description = card.querySelector("p");
    const points = card.querySelectorAll("li");

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: card,
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
    });

    tl

      // Card
      .from(card, {
        y: 120,
        opacity: 0,
        duration: 1,
        ease: "expo.out",
      })

      // Image Reveal
      .from(
        image,
        {
          clipPath: "inset(0 0 100% 0)",
          scale: 1.2,
          filter: "blur(12px)",
          duration: 1.5,
          ease: "expo.out",
        },
        "-=0.7",
      )

      // Title
      .from(
        title,
        {
          y: 40,
          opacity: 0,
          duration: 0.7,
          ease: "power3.out",
        },
        "-=1",
      )

      // Description
      .from(
        description,
        {
          y: 20,
          opacity: 0,
          duration: 0.6,
          ease: "power2.out",
        },
        "-=0.5",
      )

      // Points
      .from(
        points,
        {
          x: 25,
          opacity: 0,
          stagger: 0.06,
          duration: 0.45,
          ease: "power2.out",
        },
        "-=0.4",
      );
  });

  // ----------------------------
  // Floating Image Effect
  // ----------------------------
  gsap.utils.toArray(".step-image img").forEach((img: any, index) => {
    gsap.to(img, {
      y: gsap.utils.random(-10, -5),
      rotation: gsap.utils.random(-2, 2),
      duration: gsap.utils.random(2.5, 4),
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
      delay: index * 0.15,
    });
  });

  // ----------------------------
  // Subtle Parallax
  // ----------------------------
  gsap.utils.toArray(".step-image img").forEach((img: any) => {
    gsap.to(img, {
      yPercent: -8,
      ease: "none",
      scrollTrigger: {
        trigger: img,
        start: "top bottom",
        end: "bottom top",
        scrub: 1,
      },
    });
  });
</script>


