---
import LinkButton from "@/components/ui/LinkButton.astro";

const recentBlogs = Object.values(
  import.meta.glob("@/content/blogs/blog/*.{md,mdx}", {
    eager: true,
  }),
)
  .map((blog: any) => blog.frontmatter)
  .reverse()
  .slice(0, 2);
---

<section id="related-blogs-section" class="mx-8 my-26">
  <div class="flex items-center justify-between mb-16">
    <h2
      class="related-title font-commissioner text-[20px] md:text-[24px] leading-[110%] font-semibold uppercase tracking-[-0.04em] text-[#301C1B]"
    >
      Related Blogs
    </h2>
    <LinkButton href="/blog" text="All Works" class="related-button" />
  </div>

  <div
    class="related-blog-card grid grid-cols-1 lg:grid-cols-2 border-[#D9D4CF]"
  >
    {
      recentBlogs.map((blog: any) => (
        <a href={`/blog/${blog.slug}`} class="group  border last:border-l-0">
          <div class="overflow-hidden p-5 related-blog-image">
            <img
              src={blog.image}
              alt={blog.thumbnailTitle}
              class=" aspect-4/3 w-full object-cover transition duration-500 group-hover:scale-102"
            />
          </div>

          <div class="border-t">
            <div class="px-5 pt-5 pb-7 related-blog-date">
              <h3 class=" font-dm-mono font-normal  text-[14px] leading-[150%] tracking-[-4%] text-primary  group-hover:text-primary transition">
                {blog.date}
              </h3>
              <h3 class="mt-2 font-commissioner font-semibold  text-[20px] leading-[110%] tracking-[-4%] text-[#301C1B]  group-hover:text-primary transition">
                {blog.thumbnailTitle}
              </h3>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#related-blogs-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Header
  tl.from(".related-title", {
    y: 60,
    opacity: 0,
    duration: 1,
    ease: "expo.out",
  })

    .from(
      ".related-button",
      {
        x: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.7",
    )

    // Cards
    .from(
      ".related-blog-card",
      {
        y: 80,
        opacity: 0,
        duration: 1,
        stagger: 0.2,
        ease: "expo.out",
      },
      "-=0.4",
    )

    // Images
    .from(
      ".related-blog-image",
      {
        scale: 1.15,
        opacity: 0,
        duration: 1.2,
        stagger: 0.15,
        ease: "power3.out",
      },
      "-=0.9",
    )

    // Dates
    .from(
      ".related-blog-date",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "power2.out",
      },
      "-=0.8",
    )

    // Titles
    .from(
      ".related-blog-title",
      {
        y: 35,
        opacity: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
      },
      "-=0.5",
    );
</script>
