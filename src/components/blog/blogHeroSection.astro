---
import Container from "../ui/Container.astro";
import LinkButton from "../ui/LinkButton.astro";
import * as blogData from "@/content/blogs/blog-hero-content.md";
const blogs = Object.values(
  import.meta.glob("@/content/blogs/blog/*.{md,mdx}", {
    eager: true,
  }),
);

const latestBlog = blogs[0] as any;

const { title, description, button } = blogData.frontmatter;
---

<section id="blog-hero-section" class="border-b">
  <Container>
    <div class="flex flex-col lg:flex-row">
      <!-- Left -->
      <div class="w-full lg:w-100 shrink-0 px-8 py-13 flex flex-col">
        <h2
          class="blog-hero-title pt-12.25 font-commissioner text-[28px] font-semibold uppercase leading-[110%] tracking-[-0.04em] text-primary"
        >
          {title}
        </h2>

        <p
          class="blog-hero-description pt-14 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-0.04em] text-[#301C1B]/70 max-w-72.5"
        >
          {description}
        </p>

        <div class="mt-auto blog-hero-cta">
          <LinkButton href={button.link} text={button.text} class="mt-67.25" />
        </div>
      </div>

      <!-- Right -->
      <div class="blog-right flex-1 bg-[#301C1B] p-13">
        <h3
          class="blog-hero-label mb-6 font-commissioner text-[24px] font-semibold leading-[110%] tracking-[-0.04em] uppercase text-white"
        >
          Latest Blog
        </h3>

        <a href={`/blog/${latestBlog.frontmatter.slug}`} class="group block">
          <div class="blog-hero-image overflow-hidden">
            <img
              src={latestBlog.frontmatter.image}
              alt={latestBlog.frontmatter.thumbnailTitle}
              class="max-h-100 w-full object-cover transition duration-500 hover:scale-105"
            />
          </div>

          <div class="mt-5">
            <p
              class="blog-hero-date font-dm-mono font-normal leading-[150%] tracking-[-4%] text-[14px] text-primary cursor-default"
            >
              {latestBlog.frontmatter.date}
            </p>

            <div
              class="mt-4
              flex
              items-end
              justify-between
              gap-6"
            >
              <h4
                class="blog-hero-post-title max-w-162.5 font-commissioner text-[20px] font-semibold leading-[110%] tracking-[-4%] text-white cursor-default"
              >
                {latestBlog.frontmatter.thumbnailTitle}
              </h4>

              <span
                class="blog-hero-read-more flex items-center gap-2 whitespace-nowrap font-commissioner text-primary text-[14px] font-normal leading-[150%] tracking-[-4%] hover:text-white"
              >
                Read the Blog

                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none">
                  <path
                    d="M7 17L17 7M17 7H9M17 7V15"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </Container>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#blog-hero-section",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".blog-hero-title", {
    y: 100,
    opacity: 0,
    ease: "power4.out",
  })

    .from(
      ".blog-hero-description",
      {
        y: 40,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".blog-hero-cta",
      {
        y: 30,
        opacity: 0,
        scale: 0.9,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".blog-hero",
      {
        x: 100,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    .from(
      ".blog-hero-label",
      {
        y: 25,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    .from(
      ".blog-hero-image",
      {
        scale: 0.9,
        opacity: 0,
        ease: "power4.Out",
      },
      "-=0.6",
    )

    .from(
      ".blog-hero-date",
      {
        y: 15,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    .from(
      ".blog-hero-post-title",
      {
        y: 40,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".blog-hero-read-more",
      {
        x: 20,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    );

  // Read more hover
  document.querySelectorAll(".blog-read-more").forEach((item) => {
    item.addEventListener("mouseenter", () => {
      gsap.to(item.querySelector("svg"), {
        x: 5,
        y: -2,
        duration: 0.3,
      });
    });

    item.addEventListener("mouseleave", () => {
      gsap.to(item.querySelector("svg"), {
        x: 0,
        y: 0,
        duration: 0.3,
      });
    });
  });
</script>
