---
import * as latestData from "@/content/home/latestwork-content.md";
import latestWorkIcon from "@/assets/sectionIcon/latestwork.svg";
// import LatestWorkSwitcher from "@/components/Home/LatestWork/LatestWorkSwitcher";

import * as latestdata from "@/components/Home/LatestWork/latestCardContent.md";
import LatestWorkSwitcher from "./LatestWork/LatestWorkSwitcher";
import LatestWorkCard from "./LatestWork/LatestWorkCard";
import Container from "../ui/Container.astro";
const { title, subTitle, description, cards } = latestData.frontmatter;
---

<section id="latest-work" class="bg-[#E8704E] overflow-x-hidden">

  <div class="mx-auto">
    <!-- Top Container - Header Section -->
 <div class="border-b border-white/20">
 <Container>
      <div
      class="latest-header flex flex-col lg:flex-row "
    >
  
      <!-- Left: Icon + Title -->
      <div
        class="latest-title w-full lg:w-[20%] lg:border-r border-white/20 px-4 md:px-8 pt-10 lg:pt-20"
      >
        <div class="flex items-center gap-2">
          <img
            src={latestWorkIcon.src}
            alt="Latest icon"
            class="latest-icon w-4 h-4 md:w-auto md:h-auto"
          />
          <h6
            class="latest-heading font-dm-mono font-normal text-[12px] sm:text-[14px] leading-[150%] tracking-[-4%] text-white"
          >
            {title}
          </h6>
        </div>
      </div> 
      <!-- Middle: SubTitle -->
      <div
        class="w-full lg:w-[40%] lg:border-r border-white/20 ml-8 lg:px-9 pt-10 lg:pt-20"
      >
        <p
          class="latest-subtitle-text font-commissioner font-semibold text-[25px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase text-white"
        >
          {subTitle}
        </p>
      </div>
      <!-- Right: Description -->
      <div class="w-full lg:w-[40%] pl-9 pr-8 md:px-8 pt-10 lg:pt-20 mb-16">
        <p
          class="latest-description-text font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-white/80"
        >
          {description}
        </p>
      </div>
    </div>
    </Container>
  </div>  

   
    <!-- Bottom Container - Images Grid with Full Height Image -->
    <div class="hidden lg:block">
      <Container>
      <div class="mx-8 border-x border-white/20">
        
        <LatestWorkSwitcher cards={cards} client:load  />
      
      </div>
        </Container>
      <!-- small devices -->
    </div>
        <div class="block lg:hidden mb-20">
      <!-- bottom component  -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-2 px-8">
        {
          cards.map((card: any, index: any) => (
            <div class="">
              <div
                class:list={[
                  "mx-auto border border-white/20 items-center justify-center",
                  index !== 0 && "border-t-0",
                ]}
              >
                <div class=" overflow-hidden">
  <!-- Hero Image -->
  <div class="relative h-60 overflow-hidden">
    <img
      src={card.image}
      alt={card.title}
      class=" absolute inset-0 w-full h-full object-cover transition-transform duration-700"
    />
  </div>

  <!-- Content -->
  <div class="relative bg-[#221617]">
    <!-- Dot Pattern -->
    <div
      class="absolute inset-0 opacity-20"
      style="background-image: radial-gradient(#ED7743 1px, transparent 1px); background-size: 10px 10px;"
    />

    <div class="relative z-10 p-8">
      <!-- Title -->
      <h3
        class=" font-commissioner font-semibold text-[24px] leading-[110%] tracking-[-4%] text-white uppercase"
      >
        {card.title}
      </h3>

      <!-- Tags -->
      <div class="flex flex-wrap gap-3 mt-5">
        {
          card.tags.map((tag:any) => (
            <span
              class=" px-4 py-1 rounded-full border border-[#4A3737] text-white/70 font-dm-mono text-[12px]"
            >
              {tag}
            </span>
          ))
        }
      </div>

      <!-- Description -->
      <p
        class=" mt-8 font-dm-mono text-[14px] leading-[150%] tracking-[-4%] text-white"
      >
        {card.description}
      </p>

      <!-- Industry -->
      <p
        class=" mt-8 font-dm-mono text-[14px] leading-[150%] tracking-[-4%] text-white"
      >
        Industry:
        <span class="text-[#ED7743] font-medium ml-1">
          {card.industry}
        </span>
      </p>
    </div>
  </div>
</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#latest-work",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // Icon
  tl.from(".latest-icon", {
    scale: 0.3,
    rotate: -180,
    opacity: 0,
    duration: 0.8,
    ease: "back.out(2)",
  });

  // Small title
  tl.from(
    ".latest-heading",
    {
      x: -20,
      opacity: 0,
      ease: "power3.out",
    },
    "-=0.4",
  );

  // Subtitle
  tl.from(
    ".latest-subtitle-text",
    {
      y: 80,
      opacity: 0,
      filter: "blur(8px)",
      ease: "expo.out",
    },
    "-=0.4",
  );

  // Description
  tl.from(
    ".latest-description-text",
    {
      y: 30,
      filter: "blur(8px)",
      opacity: 0,
      ease: "power2.out",
    },
    "-=0.4",
  );

  // Side Labels
  tl.from(
    ".side-box",
    {
      clipPath: "inset(100% 0 0 0)",
      opacity: 0,
      stagger: 0.12,
      duration: 0.8,
      ease: "power4.out",
    },
    "-=0.3",
  );
</script>
