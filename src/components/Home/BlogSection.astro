---
import * as blogContent from "@/content/home/blog-content.md";
import sectionIcon from "@/assets/sectionIcon/blogArticale.svg";
import LinkButton from "../ui/LinkButton.astro";
import Container from "../ui/Container.astro";
const { title, subtitle, description, buttonText, buttonLink } =
  blogContent.frontmatter;

const blogs = Object.values(
  import.meta.glob("../../content/blogs/blog/*.{md,mdx}", { eager: true }),
);
---

<section class="mt-22.75 border-y">
  <Container>
    <div id="home-blog-section" class="flex flex-col lg:flex-row items-stretch">
      <!-- Left Side - Fixed width with white background -->
      <div
        class="w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r bg-white"
      >
        <div class="mx-8 mt-13 lg:mt-26">
          <div class="flex items-center gap-2 mb-6 lg:mb-9">
            <img
              src={sectionIcon.src}
              alt="blog"
              class="w-4 h-4 md:w-auto md:h-auto home-blog-section-icon"
            />
            <h6
              class="home-blog-section-title font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary"
            >
              {title}
            </h6>
          </div>
          <p
            class="home-blog-section-subtitle font-commissioner font-semibold text-[24px] leading-[110%] tracking-[-4%] uppercase mb-8 lg:mb-49"
          >
            {subtitle}
          </p>
          <p
            class="home-blog-section-description mb-10 lg:mb-16 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-black/70"
          >
            {description}
          </p>
          <LinkButton
            href={buttonLink}
            text={buttonText}
            class="home-blog-section-button mb-10"
          />
        </div>
      </div>
      <div
        class="grid sm:grid-cols-2 my-10 lg:my-20 gap-4 ml-8 lg:ml-4.25 mr-8"
      >
        {
          blogs.slice(0, 4).map((blog: any) => (
            <a
              href={`/blog/${blog.frontmatter.slug}`}
              class="group mb-6 home-blog-section-card"
            >
              <div class="blog-image-wrapper home-blog-section-img overflow-hidden">
                <img
                  src={blog.frontmatter.image}
                  alt={blog.frontmatter.thumbnailTitle}
                  class="blog-image aspect-4/3 w-full object-cover "
                />
              </div>

              <h3 class="blog-title mt-2 font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-[#301C1B]/70 hover:text-primary transition-colors duration-300">
                {blog.frontmatter.title}
              </h3>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initBlogSection = () => {
    // Kill old triggers
    ScrollTrigger.getAll().forEach((st) => {
      if (st.trigger?.closest?.("#home-blog-section")) {
        st.kill();
      }
    });

    // =====================
    // HEADER TIMELINE
    // =====================

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#home-blog-section",
        start: "top 80%",
      },
    });

    tl.from(".home-blog-section-icon", {
      opacity: 0,
      y: 20,
      rotate: -90,
      ease: "power4.out",
    })
      .from(".home-blog-section-title", {
        opacity: 0,
        x: -20,
        ease: "power4.out",
      })
      .from(
        ".home-blog-section-subtitle",
        {
          opacity: 0,
          y: 60,
          filter: "blur(20px)",
          ease: "power4.out",
        },
        "-=0.4",
      )
      .from(
        ".home-blog-section-description",
        {
          opacity: 0,
          y: 30,
          filter: "blur(20px)",
          ease: "power3.out",
        },
        "-=0.4",
      )
      .from(
        ".home-blog-section-button",
        {
          opacity: 0,
          y: 20,
          ease: "power4.out",
        },
        "-=0.4",
      );

    // =====================
    // BLOG CARDS
    // =====================

    gsap.from(".home-blog-section-card", {
      scrollTrigger: {
        trigger: "#home-blog-section",
        start: "top 65%",
      },
      opacity: 0,
      y: 100,
      duration: 1.2,
      stagger: 0.15,
      ease: "power4.out",
    });

    // =====================
    // IMAGE REVEAL
    // =====================

    gsap.utils.toArray(".home-blog-section-card img").forEach((img: any) => {
      gsap.from(img, {
        scrollTrigger: {
          trigger: img,
          start: "top 85%",
        },
        scale: 1.2,
        clipPath: "inset(100% 0 0 0)",
        duration: 1.4,
        ease: "power4.out",
      });
    });

    // =====================
    // HOVER IMAGE PARALLAX
    // =====================

    document.querySelectorAll(".home-blog-section-img").forEach((card) => {
      const image = card.querySelector("img");

      if (!image) return;

      card.addEventListener("mouseenter", () => {
        gsap.to(image, {
          scale: 1.08,
          duration: 0.6,
          ease: "power4.out",
        });
      });

      card.addEventListener("mouseleave", () => {
        gsap.to(image, {
          scale: 1,
          duration: 0.8,
          ease: "power4.out",
        });
      });

      card.addEventListener("mousemove", (e: any) => {
        const rect = card.getBoundingClientRect();

        const x = ((e.clientX - rect.left) / rect.width - 0.5) * 20;

        const y = ((e.clientY - rect.top) / rect.height - 0.5) * 20;

        gsap.to(image, {
          x,
          y,
          duration: 0.8,
          ease: "power4.out",
        });
      });
    });

    ScrollTrigger.refresh();
  };

  initBlogSection();
</script>
