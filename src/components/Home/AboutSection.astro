---
import { Image } from "astro:assets";
import * as aboutData from "@/content/home/aboutus-content.md";
import bg from "@/assets/background/aboutSDottedbg.svg";
import aboutUs from "@/assets/sectionIcon/aboutus.svg";
import LinkButton from "../ui/LinkButton.astro";

// Access frontmatter data
const { title, subTitle, description, buttonText, buttonLink, images } =
  aboutData.frontmatter;

// Create images array for rendering
---

<section id="abouthome" class="border-b lg:border-t overflow-hidden">
  <div class="flex flex-col lg:flex-row items-stretch">
    <!-- Left Side - Fixed width with white background -->
    <div
      class="aboutHome-left w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r py-26 pl-8 pr-8.25"
    >
      <div class="flex items-center gap-2 mb-9.5">
        <Image
          src={aboutUs}
          alt="number section"
          width={16}
          height={14}
          class="about-icon w-4 h-3.5 md:w-auto md:h-auto"
        />
        <h6
          class="about-title font-dm-mono font-normal text-[12px] sm:text-[14px] leading-[150%] tracking-[-4%] text-primary"
        >
          {title}
        </h6>
      </div>
      <p
        class="about-subtitle font-commissioner font-semibold text-[20px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase pb-14"
      >
        {subTitle}
      </p>
      <p
        class="about-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] mb-20"
      >
        {description}
      </p>
      <LinkButton href={buttonLink} text={buttonText} class="about-button" />
    </div>

    <!-- Right Side - Background image ONLY on right side -->

    <div
      style={{ backgroundImage: `url(${bg.src})` }}
      class="flex-1 bg-cover bg-center bg-no-repeat mt-3 ml-3 mb-2 pt-21.5"
    >
      <div id="gallery" class="grid grid-cols-2 gap-2">
        {
          images.map((img: any, index: number) => (
            <div
              class="gallery-card flex items-center justify-center pb-10"
              data-index={index}
            >
              <img
                src={img.src}
                alt={img.name}
                class="w-auto h-auto max-w-full"
              />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ===== LEFT CONTENT TIMELINE =====
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#abouthome",
      start: "top 70%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".aboutHome-left", {
    x: -80,
    opacity: 0,
    duration: 1,
    ease: "expo.out",
  })

    // Icon
    .from(
      ".about-icon",
      {
        scale: 0,
        rotate: -45,
        opacity: 0,
        duration: 0.8,
        ease: "back.out(2)",
      },
      "-=0.6",
    )

    // Small Title
    .from(
      ".about-title",
      {
        x: -30,
        opacity: 0,
        duration: 0.7,
        ease: "power3.out",
      },
      "-=0.5",
    )

    // Subtitle
    .from(
      ".about-subtitle",
      {
        y: 70,
        opacity: 0,
        duration: 1.1,
        ease: "expo.out",
      },
      "-=0.2",
    )

    // Description
    .from(
      ".about-description",
      {
        y: 30,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.7",
    )

    // Button
    .from(
      ".about-button",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "back.out(1.7)",
      },
      "-=0.4",
    );

  // ===== GALLERY REVEAL =====
  const cards = document.querySelectorAll(".gallery-card");

  gsap.set(cards, {
    rotation: (i) => (i % 2 === 0 ? -8 : 8),
    y: 120,
    opacity: 0,
    scale: 0.9,
  });

  gsap.to(cards, {
    rotation: 0,
    y: 0,
    opacity: 1,
    scale: 1,
    duration: 1.4,
    stagger: 0.12,
    ease: "expo.out",
    scrollTrigger: {
      trigger: "#gallery",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // ===== FLOATING WAVE =====
  gsap.utils.toArray(".gallery-card img").forEach((img: any, index) => {
    gsap.to(img, {
      y: gsap.utils.random(-15, -8),
      x: gsap.utils.random(-4, 4),
      rotation: gsap.utils.random(-3, 3),
      duration: gsap.utils.random(2.5, 4),
      ease: "sine.inOut",
      repeat: -1,
      yoyo: true,
      delay: index * 0.2,
    });
  });
</script>

