---
import { NavigationMenuLink } from "../ui/navigation-menu";
import * as data from "@/content/pricing/pricing-hero-content.md";
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "../ui/carousel";
import Icon from "../ui/icon/icon.astro";
import ctaIcon2 from "@/assets/icons/chevron-down.svg";
import LinkButton from "../ui/LinkButton.astro";
import Container from "../ui/Container.astro";

const { title, description, buttonLink,buttonText,buttonLink2, buttonText2, testimonials } = data.frontmatter;
---

<!-- hero section -->

  <div class=" border-border lg:border-b">
     <Container>
<div id="pricing-hero-section" class="flex flex-col lg:flex-row  overflow-hidden">
  <!-- Left Content -->
  <div
    class="px-8  pt-21.25 w-full shrink-0 border-b border-border 8 lg:w-100 lg:border-b-0 lg:border-r"
  >
    <div class="flex h-full flex-col ">
      <div>
        <h3
          class="pricing-title mb-14 font-commissioner text-2xl sm:text-[28px] font-semibold uppercase leading-[110%] tracking-[-4%] text-primary"
        >
          {title}
        </h3>

        <p
          class="pricing-description mb-50.5 max-w-full lg:max-w-[320px] font-dm-mono text-sm leading-[150% text-black/70"
        >
          {description}
        </p>
      </div>
      <!-- button -->
       <div class="pricing-buttons lg:mt-auto  rounded-0">
      <div class=" flex gap-2 mb-13">
        <LinkButton href={buttonLink} text= {buttonText}/>
        <NavigationMenuLink
          href={buttonLink2}
          class="w-36.25 border h-11.25 py-3 px-2.5  cursor-pointer flex items-center justify-center gap-2 rounded-none"
        >
          <span
            class=" whitespace-nowrap font-commissioner font-normal text-[14px] leading-[150%] tracking-[-4%] text-[#301C1B]"
          >
            {buttonText2}
          </span>
          <img src={ctaIcon2.src} alt="icon" class="animate-bounce" />
        </NavigationMenuLink>
      </div>
    </div>
    </div>
  </div>

  <!-- Right Gallery -->
<div class="pricing-slider relative flex-1 py-33 px-8 lg:px-18 bg-[#301C1B]">
  <Carousel class="h-full">
    <CarouselContent>
      {
        testimonials.map((item: any) => (
          <CarouselItem>
            <div class="flex flex-col ">
              <!-- Quote -->
              <div class="mb-14">
                <Icon
                  name="quote"
                  class="pricing-quote size-10 text-white font-normal font-dm-mono"
                />
              </div>

              <!-- Testimonial -->
              <p
                class="pricing-testimonial mb-14 max-w-190 font-dm-mono font-normal text-[24px] leading-[150%] tracking-[-4%] text-primary"
              >
                {item.description}
              </p>

              <!-- Bottom -->
              <div class="mt-auto ">
                <div class="border-t border-primary"></div>

                <div class="mt-6 flex items-center justify-between">
                  <div class="flex items-center gap-5">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="pricing-avatar h-14 w-14 object-cover"
                    />

                    <div>
                      <h4
                        class="pricing-name font-dm-mono text-[14px] leading-[150%] tracking-[-4%]font-medium text-white"
                      >
                        {item.name}
                      </h4>

                      <p
                        class="pricing-role font-dm-mono text-[14px] leading-[150%]   tracking-[-4%] font-normal text-white"
                      >
                        {item.designation}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </CarouselItem>
        ))
      }
    </CarouselContent>

 <!-- Navigation -->
        <div class="absolute bottom-0 right-0 flex items-center">
          <CarouselPrevious
            class="static h-6 w-6 rounded-none border-r hover:text-primary cursor-pointer hover:bg-[#1d1615] border-white/20 outline-1 bg-[#301C1B] text-primary shadow-none"
          />

          <CarouselNext class="static hover:bg-[#1d1615] hover:text-primary bg-[#301C1B] border-white/20 h-6 w-6 cursor-pointer rounded-none text-primary shadow-none" />
        </div>
  </Carousel>
</div>
</div>
</Container>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#pricing-hero-section",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".pricing-title", {
    y: 100,
    opacity: 0,
    ease: "power4.out",
  })

    .from(
      ".pricing-description",
      {
        y: 40,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".pricing-buttons > *",
      {
        y: 30,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".pricing-slider",
      {
        y: 80,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".pricing-quote",
      {
        scale: 0.3,
        rotate: -25,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    .from(
      ".pricing-testimonial",
      {
        y: 50,
        opacity: 0,
        duration: 1,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".pricing-avatar",
      {
        scale: 0.6,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    .from(
      ".pricing-name",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power4.out",
      },
      "-=0.4",
    )

    .from(
      ".pricing-role",
      {
        y: 15,
        opacity: 0,
        duration: 0.5,
        ease: "power4.out",
      },
      "-=0.4",
    );

  // Avatar floating
  gsap.to(".pricing-avatar", {
    y: -6,
    duration: 2.5,
    repeat: -1,
    yoyo: true,
    ease: "power4.out",
  });
  
</script>