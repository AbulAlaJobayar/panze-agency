---
import Container from "@/components/ui/Container.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
const { hero } = Astro.props;
const { title, subTitle, buttonText, buttonLink, image } = hero;
---

<section id="services-section-hero" class="overflow-hidden border-b">
  <Container>
    <div class="flex flex-col lg:flex-row items-stretch">
      <!-- Left Side - Fixed width with white background -->
      <div
        class="hero-content w-full lg:w-100 shrink-0 lg:border-r pt-22.5 px-8"
      >
        <h3
          class="hero-services-title font-commissioner font-semibold text-[28px] uppercase leading-[110%] tracking-[-4%] text-primary"
        >
          {title}
        </h3>
        <p
          class="mt-14 hero-services-subtitle font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-black/70"
        >
          {subTitle}
        </p>
        <div class="hero-services-button mt-33.5">
          <LinkButton href={"/contact"} text={buttonText} class="w-full" />
        </div>
      </div>

      <!-- Right Side -->
      <div
        class="max-h-159.75 services-hero-images-wrapper mx-8 mt-8.75 mb-12.75"
      >
        <img src={image} alt={title} class="services-hero-images" />
      </div>
    </div>
  </Container>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Prevent duplicate animations
  ScrollTrigger.getAll().forEach((st) => st.kill());

  const tl = gsap.timeline({
    defaults: {
      ease: "power4.out",
    },
  });

  // Initial states
  gsap.from(".services-hero-images", {
    clipPath: "inset(100% 0% 0% 0%)",
    duration: 0.8,
    ease: "power4.out",
  });

  tl.from(".hero-services-title", {
    y: 120,
    opacity: 0,
    filter: "blur(20px)",
  })
    .from(
      ".hero-services-subtitle",
      {
        y: 40,
        opacity: 0,
        filter: "blur(20px)",
      },
      "-=0.6",
    )
    .from(
      ".hero-services-button",
      {
        y: 40,
        opacity: 0,
        filter: "blur(20px)",
      },
      "-=0.6",
    );
</script>
