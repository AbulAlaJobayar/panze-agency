---
const { benifits } = Astro.props;
import sectionicon from "@/assets/sectionIcon/benifitsicon.svg";
import Container from "@/components/ui/Container.astro";

const { title, subTitle, description, steps } = benifits;
---

<section id="services-benefits-section" class="border-y overflow-hidden">
  <Container>
    <div class="flex flex-col lg:flex-row items-center">
      <!-- Left Side - Fixed width with white background -->
      <div
        class="py-10 lg:py-0 w-full lg:w-100 shrink-0 border-b lg:border-b-0 px-8"
      >
        <div class="flex items-center gap-2 mb-9.5">
          <img
            src={sectionicon.src}
            alt="benifit section"
            class="w-3 h-3 md:w-auto md:h-auto services-benefits-section-icon"
          />
          <h6
            class="services-benefits-section-title font-dm-mono font-normal [14px] leading-[150%] tracking-[-4%] text-primary"
          >
            {title}
          </h6>
        </div>
        <h3
          class="services-benefits-section-subTitle mb-14 font-commissioner font-semibold text-[28px] uppercase leading-[110%] tracking-[-4%] text-[#301C1B]"
        >
          {subTitle}
        </h3>
        <p
          class="services-benefits-section-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-black/70"
        >
          {description}
        </p>
      </div>

      <!-- Right Side - Background image ONLY on right side -->
      <div class="border-l">
        <div class="grid grid-cols-1 sm:grid-cols-2 border border-white/20">
          {
            steps.map((step: any, index: any) => (
              <div
                class="services-benefit-section-card border-r border-b  p-8  min-h-47.5
                lg:even:border-r-0
               nth-last-[-n+2]:border-b-0"
              >
                <h3 class="services-benefit-section-number font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-[#301C1B] mb-6">
                  {index + 1}. {step.title}
                </h3>

                <p class="font-dm-mono text-[14px] leading-[150%] tracking-[-4%] text-black/70 max-w-[320px]">
                  {step.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#services-benefits-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // Left content reveal
  tl.from(".services-benefits-section-icon", {
    opacity: 0,
    rotate: -90,
    ease: "power4.out",
  })
    .from(".services-benefits-section-title", {
      opacity: 0,
      x: -20,
      ease: "power4.out",
    },"-=0.5")
    .from(
      ".services-benefits-section-subTitle",
      {
        y: 40,
        opacity: 0,
        filter: "blur(20px)",
        ease: "power4.out",
      },
      "-=0.5",
    )
    .from(
      ".services-benefits-section-description",
      {
        y: 40,
        opacity: 0,
        filter: "blur(20px)",
        ease: "power4.out",
      },
      "-=0.4",
    );

  // Cards stagger
  tl.from(
    ".services-benefit-section-card",
    {
      y: 80,
      opacity: 0,
      stagger: {
        amount: 0.08,
        grid: "auto",
        from: "start",
      },
      ease: "power4.out",
    },
    "-=0.5",
  );

  // Numbers reveal
  tl.from(
    ".services-benefit-section-number",
    {
      y: 20,
      opacity: 0,
      stagger: 0.08,
    },
    "-=0.5",
  );
</script>
