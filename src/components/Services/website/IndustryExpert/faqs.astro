---
import Accordion from "@/components/ui/accordion/accordion.astro";
import { cn } from "@/lib/utils";
import AccordionItem from "@/components/ui/accordion/accordion-item.astro";
import AccordionTrigger from "@/components/ui/accordion/accordion-trigger.astro";
import AccordionContent from "@/components/ui/accordion/accordion-content.astro";

const { class: className, faqs } = Astro.props;
---

<div class={cn("", className)}>
  <div class="">
    <Accordion collapsible defaultValue={faqs[0].id}>
      {
        faqs.map((item: any, index: number) => (
          <AccordionItem value={item.id} class={"faq-item border-white/20 px-8 lg:px-4"}>
            <AccordionTrigger
              iconActive={false}
              class={
                "py-4 font-dm-mono font-normal text-[16px] leading-[150%] tracking-[-4%] text-white data-[state=open]:hidden"
              }
            >
              {item.question}
            </AccordionTrigger>
            <AccordionContent>
              <div class="flex flex-col lg:flex-row  pt-4 items-center gap-6">
                <img src={item.image} alt={item.question} class="faq-image" />

                <div class="mr-6 faq-details">
                  <h3 class=" font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-white mb-3">
                    {item.question}
                  </h3>
                  <p class="font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-white/30">
                    {item.answer}
                  </p>
                </div>
              </div>
            </AccordionContent>
          </AccordionItem>
        ))
      }
    </Accordion>
  </div>
</div>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Initial reveal
  gsap.from(".faq-item", {
    scrollTrigger: {
      trigger: ".faq-item",
      start: "top 85%",
    },
    y: 40,
    opacity: 0,
    duration: 0.8,
    stagger: 0.08,
    ease: "power3.out",
  });

  // Accordion open animation
  document.querySelectorAll(".faq-item").forEach((item) => {
    const image = item.querySelector(".faq-image");
    const details = item.querySelector(".faq-details");

    const animateOpen = () => {
      if (!image || !details) return;

      const tl = gsap.timeline();

      tl.fromTo(
        image,
        {
          scale: 1.15,
          opacity: 0,
          filter: "blur(12px)",
        },
        {
          scale: 1,
          opacity: 1,
          filter: "blur(0px)",
          duration: 0.9,
          ease: "expo.out",
        },
      ).fromTo(
        details,
        {
          y: 25,
          opacity: 0,
        },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          ease: "power3.out",
        },
        "-=0.5",
      );
    };

    const observer = new MutationObserver(() => {
      const content = item.querySelector("[data-state='open']");

      if (content) {
        animateOpen();
      }
    });

    observer.observe(item, {
      subtree: true,
      attributes: true,
      attributeFilter: ["data-state"],
    });
  });
</script>
