---
import Faqs from "./faqs.astro";
import icon from "@/assets/sectionIcon/benifitsicon.svg";
const { industryExpert } = Astro.props;
const { title, subtitle, description, faqs } = industryExpert;
---

<section
  id="industry-expert-section"
  class="overflow-hidden bg-[#1E1212] py-26 mt-26 "
>
  <div
    class="flex flex-col lg:flex-row border-y border-white/20 my-auto items-center"
  >
    <!-- Content -->
    <div
      class="w-full lg:w-100 lg:shrink-0
           border-b border-white/10
           lg:border-b-0
           px-8
           py-12 md:py-16 lg:py-20"
    >
      <div class="flex items-center gap-2">
        <img
          src={icon.src}
          alt={title}
          class="size-3 md:size-auto industry-icon"
        />

        <h6
          class="industry-label font-dm-mono
               text-sm
               font-normal
               leading-[150%]
               tracking-[-4%]
               text-primary"
        >
          {title}
        </h6>
      </div>

      <h2
        class="industry-title mt-9.5
             font-commissioner
             text-xl sm:text-2xl md:text-[28px]
             font-semibold
             uppercase
             leading-[110%]
             tracking-[-0.04em]
             text-white"
      >
        {subtitle}
      </h2>

      <p
        class="industry-description mt-9.5 lg:mt-25.75
             max-w-md
             font-dm-mono
             text-sm
             leading-[150%]
             tracking-[-0.04em]
             text-white/80"
      >
        {description}
      </p>
    </div>

    <!-- FAQ -->
    <div
      class="industry-faq flex-1
           border-white/10
           lg:border-l"
    >
      <Faqs faqs={faqs} />
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#industry-expert-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Icon
  tl.from(".industry-icon", {
    scale: 0.4,
    rotate: -20,
    opacity: 0,
    duration: 0.8,
    ease: "back.out(2)",
  })

    // Label
    .from(
      ".industry-label",
      {
        x: -20,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
      },
      "-=0.5",
    )

    // Main title
    .from(
      ".industry-title",
      {
        y: 80,
        opacity: 0,
        duration: 1.2,
        ease: "expo.out",
      },
      "-=0.2",
    )

    // Description
    .from(
      ".industry-description",
      {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 1,
        ease: "power3.out",
      },
      "-=0.8",
    )

    // FAQ side container
    .from(
      ".industry-faq",
      {
        x:20,
        opacity: 0,
        duration: 1.1,
        ease: "expo.out",
      },
      "-=0.8",
    );

  // Border reveal
  gsap.from("#industry-expert-section .border-y", {
    scrollTrigger: {
      trigger: "#industry-expert-section",
      start: "top 80%",
    },
    scaleX: 0,
    transformOrigin: "left center",
    duration: 1.2,
    ease: "power3.out",
  });
</script>
