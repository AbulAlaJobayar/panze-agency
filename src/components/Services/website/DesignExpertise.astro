---
import icon from "@/assets/sectionIcon/expertise.svg";
import Container from "@/components/ui/Container.astro";
const { designExpertise } = Astro.props;
---

<Container>
  <section id="design-expertise-section">
    <div class="px-8 my-26">
      <!-- left -->
      <div class="flex flex-col lg:flex-row border-b border-white/20">
        <!-- Left: Icon + Title -->
        <div
          class="w-full lg:w-50 border-b lg:border-b-0 lg:border-r border-white/20"
        >
          <div class="flex items-center gap-2">
            <img
              src={icon.src}
              alt={designExpertise.title}
              class="w-4 h-4 md:w-auto md:h-auto design-icon"
            />
            <h6
              class="design-label font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary"
            >
              {designExpertise.title}
            </h6>
          </div>
        </div>

        <!-- Middle: SubTitle -->
        <div
          class="w-full lg:w-92 border-b lg:border-b-0 lg:border-r border-white/20"
        >
          <p
            class="my-9.5 lg:my-0 design-subtitle font-commissioner font-semibold text-[24px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase text-[#301C1B]"
          >
            {designExpertise.subtitle}
          </p>
        </div>

        <!-- Right: Description -->
        <div class="w-full lg:w-116 ml-auto mb-16">
          <p
            class="design-description text-[#301C1B] font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%]"
          >
            {designExpertise.description}
          </p>
        </div>
      </div>
      <!-- right  -->
      <div
        class="design-card grid grid-cols-1 lg:grid-cols-2 border-t lg:border-t-0 border-l lg:border-l-0 border-black/10"
      >
        {
          designExpertise.steps.map((service: any, index: any) => (
            <article
              class:list={[
                "grid md:grid-cols-[180px_1fr] min-h-42.5 p-8 gap-8",

                // Mobile
                "border-r border-b border-black/10",

                // Desktop
                index % 2 === 1 && "lg:border-r-0",
              ]}
            >
              <h3 class="design-card-title font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-primary">
                {service.title}
              </h3>
              <p class="design-card-description">{service.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#design-expertise-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // Icon
  tl.from(".design-icon", {
    scale: 0.4,
    rotate: -20,
    opacity: 0,
    ease: "power4.out",
  })

    // Label
    .from(
      ".design-label",
      {
        x: -20,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.5",
    )

    // Subtitle
    .from(
      ".design-subtitle",
      {
        y: 80,
        opacity: 0,
        filter: "blur(20px)",
        ease: "power4.out",
      },
      "-=0.4",
    )

    // Description
    .from(
      ".design-description",
      {
        y: 40,
        opacity: 0,
        filter: "blur(20px)",
        ease: "power4.out",
      },
      "-=0.4",
    )

    // Cards
    .from(
      ".design-card",
      {
        y: 60,
        opacity: 0,
        stagger: {
          amount: 0.05,
          grid: "auto",
          from: "start",
        },
        ease: "power4.out",
      },
      "-=0.5",
    )

    // Titles
    .from(
      ".design-card-title",
      {
        y: 20,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.8",
    )

    // Descriptions
    .from(
      ".design-card-description",
      {
        y: 20,
        opacity: 0,
        stagger: 0.05,
        ease: "power4.out",
      },
      "-=0.5",
    );
</script>
