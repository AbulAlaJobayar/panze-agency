---
import Container from "@/components/ui/Container.astro";

const { taskManagement } = Astro.props;
---

<Container>
  <section id="task-management-section" class="mt-15.5">
    <div class="overflow-hidden px-8">
    
      <img
        src={taskManagement.image}
        alt={taskManagement.name}
        class="task-management-image w-full h-full object-cover"
      />
    </div>
  </section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#task-management-section",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".task-management-image", {
    clipPath: "inset(0 0 100% 0)",
    filter: "blur(20px)",
    ease: "power4.out",
  });
</script>
