---
import Container from "@/components/ui/Container.astro";

const { projectInfo } = Astro.props;
---

<section class="border-b border-primary">
  <Container>
    <div
      id="project-info-section"
      class="mt-10 pb-14 flex flex-wrap lg:flex-nowrap items-start gap-x-13 mx-8"
    >
      {
        projectInfo.map((item: any) => (
          <div
            class:list={[
              "project-info-item",
              item.label === "Deliverables"
                ? "flex-1 min-w-0"
                : "w-fit flex-none",
            ]}
          >
            <h4 class="project-info-label font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-0.04em] text-[#301C1B] whitespace-nowrap">
              {item.label}:
            </h4>

            <p class="project-info-value mt-3 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-0.04em] text-[#301C1B] ">
              {Array.isArray(item.value) ? item.value.join(" - ") : item.value}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#project-info-section",
      start: "top 100%",
      toggleActions: "play none none reverse",
    },
  });

  // Blocks
  tl.from(".project-info-item", {
    y: 40,
    opacity: 0,
    stagger: 0.12,
    ease: "power4.out",
  })

    // Labels
    .from(
      ".project-info-label",
      {
        y: 20,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.5",
    )

    // Values
    .from(
      ".project-info-value",
      {
        y: 15,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.4",
    );
</script>
