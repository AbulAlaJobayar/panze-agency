---
import Container from "@/components/ui/Container.astro";
import LinkButton from "@/components/ui/LinkButton.astro";

const { relatedWork } = Astro.props;
const rows = [];

for (let i = 0; i < relatedWork.items.length; i += 2) {
  rows.push(relatedWork.items.slice(i, i + 2));
}
---
<Container>
<section id="related-work-section" class="py-26">
  <div class="px-8 ">
    <div class="mb-16 flex items-center justify-between">
      <h2
        class="related-work-title font-commissioner
          text-[24px]
          font-semibold
          leading-[110%]
          uppercase
          tracking-[-4%]
          text-primary"
      >
        {relatedWork.sectionTitle}
      </h2>
      <LinkButton href="/works"  text="All Works" class="related-work-button"/>
    </div>
     <div class="space-y-16">
    {
      rows.map((row, rowIndex) => {
        const reverse = rowIndex % 2 === 1;

        return (
          <div class="flex flex-col lg:flex-row ">
            {row.map((project: any, index: number) => {
              const width = reverse
                ? index === 0
                  ? "lg:w-3/5"
                  : "lg:w-2/5"
                : index === 0
                  ? "lg:w-2/5"
                  : "lg:w-3/5";

              return (
               <div class={width}>
                <a href={`/works/${project.slug}`} class="block group">
                    <article class="related-work-card h-140.5 flex flex-col">
                <!-- Image Border -->
                <div
                    class:list={[
                    "border border-primary p-4",
                    index === 0 && "lg:border-r-0",
                    ]}
                >
                    <img
                    src={project.thumbnail}
                    alt={project.title}
                    class="related-work-image w-full h-112 object-cover transition-transform duration-500 ease-out hover:scale-102"
                    />
                </div>

                <!-- Content  -->
                <div class="flex-1 flex flex-col mt-5">
                    <h3 class="related-work-name font-commissioner font-semibold text-[16px] leading-[110%] tracking-[-0.04em] text-[#1E1212] hover:text-primary ">
                    {project.title}
                    </h3>

                    <div class="mt-auto flex flex-wrap gap-2 pt-5">
                    {project.tags?.map((tag: string) => (
                        <span class="related-work-tag rounded-full border  px-4 py-1 font-dm-mono text-[12px] leading-[150%] tracking-[-0.04em] text-[#1E1212]">
                        {tag}
                        </span>
                    ))}
                    </div>
                </div>
                </article>
                </a>
                </div>
              );
            })}
          </div>
        );
      })
    }
  </div>
  </div>
</section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#related-work-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Header
  tl.from(".related-work-title", {
    y: 60,
    opacity: 0,
    duration: 1,
    ease: "expo.out",
  })

    .from(
      ".related-work-button",
      {
        x: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.7",
    ).from(
      ".related-work-name",
      {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: "power3.out",
      },
      "-=0.8",
    )

    // Tags
    .from(
      ".related-work-tag",
      {
        y: 15,
        opacity: 0,
        scale: 0.8,
        duration: 0.5,
        stagger: 0.03,
        ease: "back.out(1.7)",
      },
      "-=0.5",
    );
</script>