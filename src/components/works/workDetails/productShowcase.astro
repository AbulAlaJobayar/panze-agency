---
import Container from "@/components/ui/Container.astro";

const { projectShocase } = Astro.props;
---

<Container>
  <section id="product-showcase-section" class="py-26">
    <div class="overflow-hidden px-8">
      <img
        src={projectShocase.image}
        alt={projectShocase.name}
        class="product-showcase-image w-full h-auto object-cover"
      />
    </div>
  </section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#product-showcase-section",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".product-showcase-image", {
    clipPath: "inset(0 0 100% 0)",
    duration: 1,
    ease: "power4.out",
  });
</script>
