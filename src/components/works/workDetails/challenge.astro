---
const { challenges } = Astro.props;
---

<section id="challenges-section">
  <div class="grid grid-cols-1 lg:grid-cols-3 mx-8">
    {
      challenges.items.map((item: any, index: number) => (
        <div
          class:list={[
            "challenge-card p-6 pb-4.25",
            "border-b border-black/20 last:border-b-0",
            // Desktop
            "lg:border-b-0",
            "lg:border-l",
            index === challenges.items.length - 1 && "lg:border-r",
          ]}
        >
          <h3 class="challenge-title font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary">
            {item.title}
          </h3>

          <p class="challenge-description mt-8 max-w-[320px] font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-[#301C1B]">
            {item.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#challenges-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Cards reveal
  tl.from(".challenge-card", {
    y: 70,
    opacity: 0,
    duration: 1,
    stagger: {
      amount: 0.4,
      from: "start",
    },
    ease: "expo.out",
  })

    .from(
      ".challenge-title",
      {
        y: 20,
        opacity: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: "power3.out",
      },
      "-=0.7",
    )

    // Descriptions
    .from(
      ".challenge-description",
      {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.08,
        ease: "power2.out",
      },
      "-=0.5",
    );
</script>
