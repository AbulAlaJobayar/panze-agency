---
const { title, description, image } = Astro.props;
---

<section id="work-detail-hero" class="border-b border-black/20">
  <div class="flex flex-col lg:flex-row">
    <!-- Left -->
    <div
      class="min-h-159.5 px-8 w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r border-black/20 bg-white flex flex-col justify-center"
    >
      <h2
        class="work-detail-title font-commissioner text-primary uppercase font-semibold text-[28px] leading-[110%] tracking-[-0.04em]"
      >
        {title}
      </h2>

      <p
        class="work-detail-description mt-14 max-w-77.5 font-dm-mono text-[#5B5151] text-[15px] leading-[180%] tracking-[-0.04em]"
      >
        {description}
      </p>
    </div>

    <!-- Right -->
    <div class="flex-1 w-full  lg:min-h-159.5 overflow-hidden">
      <img
        src={image}
        alt={title}
        class="work-detail-image w-full h-full object-cover"
      />
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#work-detail-hero",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Title
  tl.from(".work-detail-title", {
    y: 80,
    opacity: 0,
    duration: 1.2,
    ease: "expo.out",
  })

    // Description
    .from(
      ".work-detail-description",
      {
        y: 40,
        opacity: 0,
        duration: 0.9,
        ease: "power3.out",
      },
      "-=0.8",
    )

    // Image Reveal
    .from(
      ".work-detail-image",
      {
        clipPath: "inset(0 0 100% 0)",
        scale: 1.15,
        duration: 1.5,
        ease: "expo.out",
      },
      "-=1",
    );

 
</script>
