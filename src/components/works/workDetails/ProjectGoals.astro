---
const { projectGoal } = Astro.props;
---

<section id="project-goal-section" class="border-y border-black/20 mt-26">
  <div class="grid grid-cols-1 lg:grid-cols-[400px_1fr]">
    <!-- Left -->
    <div
      class="px-8 py-9 border-b lg:border-b-0 lg:border-r border-black/20 bg-white flex flex-col justify-center"
    >
      <!-- Section Header -->
      <div class="flex items-center gap-2">
        <img
          src={projectGoal.sectionIcon}
          alt={projectGoal.sectionTitle}
          class="size-4 goal-icon"
        />

        <span
          class="goal-section-title font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary"
        >
          {projectGoal.sectionTitle}
        </span>
      </div>

      <!-- Title -->
      <h2
        class="goal-title mt-9.5
               font-commissioner
               font-semibold
               uppercase
               text-[24px]
               leading-[110%]
               tracking-[-4%]"
      >
        {projectGoal.title}
      </h2>

      <!-- Description -->
      <p
        class="goal-description mt-14
               max-w-full
               font-dm-mono
               font-normal
               
               text-[#301C1B]"
      >
        {projectGoal.description}
      </p>
    </div>

    <!-- Right -->
    <div class="overflow-hidden">
      <img
        src={projectGoal.image}
        alt={projectGoal.title}
        class="goal-image w-full h-full object-cover aspect-4/3 md:aspect-16/10 lg:aspect-auto"
      />
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#project-goal-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".goal-icon", {
    x: 0,
    rotate: 180,
    opacity: 0,
    duration: 0.8,
    ease: "back.out(2)",
  })

    .from(
      ".goal-section-title",
      {
        x: -20,
        opacity: 0,
        duration: 0.6,
        ease: "power3.out",
      },
      "-=0.5",
    )

    .from(
      ".goal-title",
      {
        y: 80,
        opacity: 0,
        skewY: 5,
        duration: 1.2,
        ease: "expo.out",
      },
      "-=0.3",
    )

    .from(
      ".goal-description",
      {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.8",
    )
    .from(
      ".goal-image",
      {
        clipPath: "inset(0 0 100% 0)",
        scale: 1.15,
        duration: 1.5,
        ease: "expo.out",
      },
      "-=1",
    );
</script>
