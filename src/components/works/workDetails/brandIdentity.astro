---
import Container from "@/components/ui/Container.astro";

const { brandIdentity } = Astro.props;
---

<Container>
  <section id="brand-identity-section" class="mt-15.5">
    <div class="overflow-hidden px-8">
      <img
        src={brandIdentity.image}
        alt={brandIdentity.name}
        class="brand-identity-image w-full h-full object-cover"
      />
    </div>
  </section>
</Container>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#brand-identity-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".brand-identity-image", {
    clipPath: "inset(0 0 100% 0)",
    scale: 1.2,
    filter: "blur(12px)",
    ease: "power4.out",
  });
</script>
