---
import Container from "@/components/ui/Container.astro";

const { identityShowcase } = Astro.props;
---
<Container>
<section id="identity-showcase-section" class="mt-15.5">
  <div class="overflow-hidden px-8">
    <img
      src={identityShowcase.image}
      alt={identityShowcase.name}
      class="identity-showcase-image w-full h-full object-cover"
    />
  </div>
</section>
</Container>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#identity-showcase-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".identity-showcase-image", {
    clipPath: "inset(0 0 100% 0)",
    filter: "blur(20px)",
    ease: "power4.out",
  });
</script>
