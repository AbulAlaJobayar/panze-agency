---
const { testimonial } = Astro.props;
import quate from "@/assets/icons/quate.svg";
---

<section id="work-testimonial-section" class="mt-16">
  <div class="works-testimonial-border border-t border-black/20 mx-8"></div>
  <div class="flex flex-col lg:flex-row pt-14">
    <!-- Left -->
    <div
      class="w-full lg:w-100 shrink-0 border-b lg:border-b-0 border-black/20"
    >
      <h2
        class="works-testimonial-title px-8 font-commissioner font-semibold uppercase text-[24px] leading-[110%] tracking-[-0.04em] text-[#301C1B]"
      >
        {testimonial.sectionTitle}
      </h2>
    </div>

    <!-- Right -->
    <div class="flex-1 mr-8">
      <!-- Quote -->
      <img src={quate.src} alt="" class="work-testimonial-quote-icon" />
      <blockquote
        class="work-testimonial-quote mt-4 pb-8
               max-w-190
               font-dm-mono
               font-normal
               text-[16px]
               leading-[150%]
               tracking-[-0.04em]
               text-[#301C1B]"
      >
        {testimonial.quote}
      </blockquote>

      <div class="border-t border-primary work-testimonial-author-line">
        <p class="mt-5 testimonial-author">
          {testimonial.author}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#work-testimonial-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  // Top border draw
  tl.from(".works-testimonial-border", {
    scaleX: 0,
    transformOrigin: "left center",
    duration: 1,
    ease: "power3.out",
  })

    // Section title
    .from(
      ".works-testimonial-title",
      {
        y: 60,
        opacity: 0,
        duration: 1,
        ease: "expo.out",
      },
      "-=0.6",
    )

    // Quote icon
    .from(
      ".work-testimonial-quote-icon",
      {
        scale: 0.4,
        rotate: -20,
        opacity: 0,
        duration: 0.8,
        ease: "back.out(2)",
      },
      "-=0.5",
    )

    // Quote text
    .from(
      ".work-testimonial-quote",
      {
        y: 40,
        opacity: 0,
        filter: "blur(8px)",
        duration: 1,
        ease: "power3.out",
      },
      "-=0.4",
    )

    // Author line
    .from(
      ".work-testimonial-author-line",
      {
        scaleX: 0,
        transformOrigin: "left center",
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.5",
    )

    // Author name
    .from(
      ".testimonial-author",
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
        ease: "power2.out",
      },
      "-=0.3",
    );
</script>
