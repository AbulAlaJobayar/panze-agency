---
import Container from "../ui/Container.astro";

const works = Object.values(
  import.meta.glob("../../content/works/work/*.md", { eager: true }),
).sort((a: any, b: any) => a.frontmatter.order - b.frontmatter.order);

const rows = [];

for (let i = 0; i < works.length; i += 2) {
  rows.push(works.slice(i, i + 2));
}
---
<Container>
<section id="works-gallary-section" class=" px-8 py-26">
  <div class="space-y-12">
    {
      rows.map((row, rowIndex) => {
        const reverse = rowIndex % 2 === 1;

        return (
          <div class="flex flex-col lg:flex-row ">
            {row.map((project: any, index: number) => {
              const width = reverse
                ? index === 0
                  ? "lg:w-3/5"
                  : "lg:w-2/5"
                : index === 0
                  ? "lg:w-2/5"
                  : "lg:w-3/5";

              return (
               <div class={`${width} mb-6 lg-mb-0`}>
                <a href={`/works/${project.frontmatter.slug}`} class="block group">
                    <article class="h-140.5 flex flex-col">
                <!-- Image Border -->
                <div
                    class:list={[
                    "border border-primary p-4 overflow-hidden",
                    index === 0 && "lg:border-r-0",
                    ]}
                >
                    <img
                    src={project.frontmatter.thumbnail}
                    alt={project.frontmatter.title}
                    class="work-image w-full h-112 object-cover transition-transform duration-500 ease-out hover:scale-102"
                    />
                </div>

                <!-- Content  -->
                <div class="flex-1 flex flex-col mt-5">
                    <h3 class="work-title font-commissioner font-semibold text-[16px] leading-[110%] tracking-[-0.04em] text-[#1E1212] transition-colors duration-200 ease-out hover:text-primary ">
                    {project.frontmatter.title}
                    </h3>

                    <div class="mt-auto flex flex-wrap gap-1 pt-5">
                    {project.frontmatter.tags?.map((tag: string) => (
                        <span class="work-tag rounded-full border  px-4 py-1 font-dm-mono text-[12px] leading-[150%] tracking-[-0.04em] text-[#1E1212]">
                        {tag}
                        </span>
                    ))}
                    </div>
                </div>
                </article>
                </a>
                </div>
              );
            })}
          </div>
        );
      })
    }
  </div>
</section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#works-gallary-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // Images
  tl.from(".work-image", {
 clipPath: "inset(0 0 100% 0)",
    filter: "blur(12px)",
    ease: "power4.out",
  })

    // Titles
    .from(
      ".work-title",
      {
        y: 35,
        opacity: 0,
        duration: 0.8,
        stagger: 0.12,
        ease: "power4.out",
      },
      "-=0.8",
    )

    // Tags
    .from(
      ".work-tag",
      {
        y: 15,
        opacity: 0,
        stagger: 0.03,
        ease: "power4.out",
      },
      "-=0.5",
    );

</script>