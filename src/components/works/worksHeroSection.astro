---
import CountUp from "../ui/CountUp.astro";
import LinkButton from "../ui/LinkButton.astro";
import * as worksData from "@/content/works/works-hero-content.md";

const { title, description, statistics, button } = worksData.frontmatter;
---

<section id="works-hero-section" class="border-b overflow-hidden">
  <div class="flex flex-col lg:flex-row items-stretch">
    <!-- Left Side - Fixed width with white background -->
    <div
      class="px-8 pb-13 w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r bg-white"
    >
      <h3
        class="works-hero-title mt-20 font-commissioner font-semibold text-[28px] uppercase leading-[110%] tracking-[-4%] text-primary"
      >
        {title}
      </h3>
      <p
        class="works-hero-description font-dm-mono mt-14 font-normal text-[14px] leading-[150%] tracking-[-4%]"
      >
        {description}
      </p>
      <div class="works-hero-stat grid grid-cols-2 mt-20 gap-15.5">
        {
          statistics.map((item: any) => (
            <div>
              <h2 class="font-commissioner text-[28px] font-semibold leading-[110%] tracking-[-4%] text-[#301C1B]">
                <CountUp value={item.value} suffix="+" />
              </h2>

              <p class=" whitespace-nowrap mt-4 font-dm-mono text-[14px] leading-[150%] tracking-[-4%] text-primary">
                {item.title}
              </p>
            </div>
          ))
        }
      </div>
      <!-- button -->
      <LinkButton
        href={button.link}
        text={button.text}
        class="mt-33 mb-13 lg:mb-0 works-hero-cta"
      />
    </div>

    <!-- Right Side -->
    <div
      class="works-hero-visual min-h-159.5 flex-1 bg-[#1E1212] flex items-center justify-center pt-10"
    >
      <div class=""></div>
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#works-hero-section",
      start: "top 75%",
      toggleActions: "play none none reverse",
    },
  });

  tl.from(".works-hero-title", {
    y: 100,
    opacity: 0,
    duration: 1.2,
    ease: "expo.out",
  })

    .from(
      ".works-hero-description",
      {
        y: 40,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
      },
      "-=0.8",
    )

    .from(
      ".works-hero-stat",
      {
        y: 50,
        opacity: 0,
        scale: 0.8,
        stagger: 0.12,
        duration: 0.8,
        ease: "back.out(2)",
      },
      "-=0.4",
    )

    .from(
      ".works-hero-cta",
      {
        y: 30,
        opacity: 0,
        scale: 0.9,
        duration: 0.8,
        ease: "back.out(1.8)",
      },
      "-=0.4",
    )

    .from(
      ".works-hero-visual",
      {
        x: 120,
        opacity: 0,
        duration: 1.3,
        ease: "expo.out",
      },
      "-=1.2",
    );
</script>
