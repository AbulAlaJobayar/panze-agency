---
import { NavigationMenuLink } from "@/components/ui/navigation-menu";

interface Props {
  href?: string;
  text: string;
  class?: string;
  id?: string;
}

const { href, text, class: className = "", id = "" } = Astro.props;
---

<div
  id={id}
  class={`cta-button relative overflow-hidden
  w-36.25 h-11.25 bg-primary text-white ${className}`}
>
  {
    href ? (
      <NavigationMenuLink
        href={href}
        class="relative z-10 flex h-full items-center justify-center gap-3 py-3"
      >
        <span>{text}</span>

        <svg
          class="arrow w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M7 17L17 7M17 7H9M17 7V15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </NavigationMenuLink>
    ) : (
      <div class="relative z-10 flex h-full items-center justify-center gap-3 py-3">
        <span>{text}</span>

        <svg
          class="arrow w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M7 17L17 7M17 7H9M17 7V15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    )
  }
</div>
<script>
  import gsap from "gsap";

  document.querySelectorAll(".cta-button").forEach((button) => {
    const arrow = button.querySelector(".arrow");

    button.addEventListener("mouseenter", () => {
      const tl = gsap.timeline();

      // Arrow
      tl.to(
        arrow,
        {
          rotate: 45,
          duration: 0.3,
          ease: "power2.out",
        },
        0.1,
      );

      // Button scale
      tl.to(
        button,
        {
          scale: 1,
          duration: 0.3,
          ease: "power2.out",
        },
        0,
      );
    });

    button.addEventListener("mouseleave", () => {
      gsap.to(arrow, {
        x: 0,
        y: 0,
        rotate: 0,
        duration: 0.3,
      });

      gsap.to(button, {
        scale: 1,
        duration: 0.3,
      });
    });
  });
</script>
