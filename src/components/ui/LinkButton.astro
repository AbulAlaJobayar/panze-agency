---
import { NavigationMenuLink } from "@/components/ui/navigation-menu";

interface Props {
  href?: string;
  text: string;
  class?: string;
  id?: string;
}

const { href, text, class: className = "", id = "" } = Astro.props;
---

<div
  id={id}
  class={`cta-button relative overflow-hidden
  w-36.25 h-11.25 bg-primary text-white ${className}`}
>
  <!-- Shimmer -->
  <div
    class="shimmer absolute top-0 left-[-60%]
    h-full w-[40%]
    skew-x-[-20deg]
    bg-linear-to-r
    from-transparent
    via-white/60
    to-transparent
    pointer-events-none"
  >
  </div>

  <!-- Border -->
  <div
    class="border-sweep absolute bottom-0 left-[-20%]
  h-0.5 w-[40%] bg-white pointer-events-none"
  >
  </div>
  {
    href ? (
      <NavigationMenuLink
        href={href}
        class="relative z-10 flex h-full items-center justify-center gap-3 py-3"
      >
        <span>{text}</span>

        <svg
          class="arrow w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M7 17L17 7M17 7H9M17 7V15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </NavigationMenuLink>
    ) : (
      <div class="relative z-10 flex h-full items-center justify-center gap-3 py-3">
        <span>{text}</span>

        <svg
          class="arrow w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M7 17L17 7M17 7H9M17 7V15"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>
    )
  }
</div>
<script>
  import gsap from "gsap";

  document.querySelectorAll(".cta-button").forEach((button) => {
    const shimmer = button.querySelector(".shimmer");
    const border = button.querySelector(".border-sweep");
    const arrow = button.querySelector(".arrow");

    gsap.set(shimmer, {
      xPercent: -250,
    });

    gsap.set(border, {
      xPercent: -120,
    });

    button.addEventListener("mouseenter", () => {
      const tl = gsap.timeline();

      // Shimmer
      tl.fromTo(
        shimmer,
        {
          xPercent: -250,
        },
        {
          xPercent: 700,
          duration: 2,
          ease: "power2.inOut",
        },
        0,
      );

      // Bottom white runner
      tl.fromTo(
        border,
        {
          xPercent: -120,
        },
        {
          xPercent: 700,
          duration: 5,
          ease: "expo.out",
        },
        0,
      );

      // Arrow
      tl.to(
        arrow,
        {
          x: 5,
          y: -2,
          duration: 0.3,
          ease: "power2.out",
        },
        0.1,
      );

      // Button scale
      tl.to(
        button,
        {
          scale: 1.02,
          duration: 0.3,
          ease: "power2.out",
        },
        0,
      );
    });

    button.addEventListener("mouseleave", () => {
      gsap.to(arrow, {
        x: 0,
        y: 0,
        duration: 0.3,
      });

      gsap.to(button, {
        scale: 1,
        duration: 0.3,
      });

      gsap.set(shimmer, {
        xPercent: -250,
      });

      gsap.set(border, {
        xPercent: -120,
      });
    });
  });
</script>
