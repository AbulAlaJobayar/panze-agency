---
import Faqs from "./faqs.astro";
import LinkButton from "../ui/LinkButton.astro";
import faqicon from "@/assets/sectionIcon/faq.svg";
import Container from "../ui/Container.astro";
const whatsappUrl = import.meta.env.WHATSAPP_URL;
const { askedQuestion } = Astro.props;

const { title, subtitle, description, buttonText, faqs } = askedQuestion;
---

<section id="faqsection" class="h-150.5 mt-10 lg:mt-26">
  <div class="border-y">
    <Container>
      <div class="flex flex-col lg:flex-row items-stretch">
        <!-- Left Side - Fixed width with white background -->
        <div
          class="faq-left w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r px-6 md:px-8 py-10 bg-white"
        >
          <div class="flex items-center gap-2 mb-6 lg:mb-9.5">
            <img
              src={faqicon.src}
              alt="number section"
              class="faq-section-icon w-4 h-4 md:w-auto md:h-auto"
            />
            <h6
              class="faq-section-label font-dm-mono font-normal text-[12px] sm:text-[14px] leading-[150%] tracking-[-4%] text-primary"
            >
              {title}
            </h6>
          </div>
          <p
            class="faq-section-title font-commissioner font-semibold text-[20px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase mb-8 lg:mb-14"
          >
            {subtitle}
          </p>
          <p
            class="text-[#301C1B]/70 faq-section-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] mb-10 lg:mb-42.5"
          >
            {description}
          </p>
          <LinkButton
            href={whatsappUrl}
            text={buttonText}
            class="faq-section-button"
          />
        </div>

        <!-- Right Side - Background image ONLY on right side -->
        <div>
          <Faqs faqs={faqs} />
        </div>
      </div>
    </Container>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#faqsection",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // Icon
  tl.from(
    ".faq-section-icon",
    {
      rotate: 90,
      opacity: 0,
      ease: "power4.out",
    },
    "+=0.10",
  );

  // Label
  tl.from(
    ".faq-section-label",
    {
      x: -20,
      opacity: 0,
      ease: "power4.out",
    },
    "-=0.10",
  );

  // Title
  tl.from(
    ".faq-section-title",
    {
      y: 80,
      opacity: 0,
      filter: "blur(20px)",
      ease: "power4.out",
    },
    "-=0.3",
  );

  // Description
  tl.from(
    ".faq-section-description",
    {
      y: 30,
      opacity: 0,
      filter: "blur(20px)",
      ease: "power4.out",
    },
    "-=0.4",
  );

  // Button
  tl.from(
    ".faq-section-button",
    {
      y: 25,
      opacity: 0,
      scale: 0.95,
      filter: "blur(20px)",
      ease: "power4.out",
    },
    "-=0.3",
  );
</script>
