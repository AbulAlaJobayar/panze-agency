---
import Faqs from "./faqs.astro";
import LinkButton from "../ui/LinkButton.astro";
import faqicon from "@/assets/sectionIcon/faq.svg";
const whatsappUrl = import.meta.env.WHATSAPP_URL;
const { askedQuestion } = Astro.props;

const { title, subtitle, description, buttonText, faqs } = askedQuestion;
---

<section id="faq" class="overflow-hidden mt-10 lg:mt-26">
  <div class="flex flex-col lg:flex-row items-stretch border-y">
    <!-- Left Side - Fixed width with white background -->
    <div
      class="faq-left w-full lg:w-100 shrink-0 border-b lg:border-b-0 lg:border-r px-6 md:px-8 py-10 bg-white"
    >
      <div class="flex items-center gap-2 mb-6 lg:mb-9.5">
        <img
          src={faqicon.src}
          alt="number section"
          class="faq-icon w-4 h-4 md:w-auto md:h-auto"
        />
        <h6
          class="faq-label font-dm-mono font-normal text-[12px] sm:text-[14px] leading-[150%] tracking-[-4%] text-primary"
        >
          {title}
        </h6>
      </div>
      <p
        class="faq-title font-commissioner font-semibold text-[20px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase mb-8 lg:mb-14"
      >
        {subtitle}
      </p>
      <p
        class="faq-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] mb-10 lg:mb-42.5"
      >
        {description}
      </p>
      <LinkButton
        href={whatsappUrl}
        text={buttonText}
        class="faq-button mb-12"
      />
    </div>

    <!-- Right Side - Background image ONLY on right side -->
    <div class="faq-right py-5 md:py-7 lg:py-10px bg-white">
      <Faqs faqs={faqs} class="faq-item border-white/20" />
    </div>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#faq",
      start: "top 70%",
      toggleActions: "play none none reverse",
    },
  });

  // Icon
  tl.from(".faq-icon", {
    scale: 0,
    rotate: -180,
    opacity: 0,
    duration: 0.8,
    ease: "back.out(2)",
  });

  // Label
  tl.from(
    ".faq-label",
    {
      x: 20,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
    },
    "-=0.5",
  );

  // Title
  tl.from(
    ".faq-title",
    {
      y: 80,
      opacity: 0,
      duration: 1,
      ease: "expo.out",
    },
    "-=0.3",
  );

  // Description
  tl.from(
    ".faq-description",
    {
      y: 30,
      opacity: 0,
      duration: 0.7,
      ease: "power2.out",
    },
    "-=0.6",
  );

  // Button
  tl.from(
    ".faq-button",
    {
      y: 25,
      opacity: 0,
      scale: 0.95,
      duration: 0.7,
      ease: "power3.out",
    },
    "-=0.4",
  );

  // FAQ Right Panel Reveal
  tl.from(
    ".faq-right",
    {
      clipPath: "inset(0 0 100% 0)",
      opacity: 0,
      duration: 1.2,
      ease: "expo.out",
    },
    "-=0.7",
  );

  // FAQ Items Stagger
  gsap.from(".faq-item", {
    scrollTrigger: {
      trigger: ".faq-right",
      start: "top 75%",
    },
    opacity: 0,
    y: 40,
    stagger: 0.08,
    duration: 0.7,
    ease: "power3.out",
  });

  // Subtle floating icon
  gsap.to(".faq-icon", {
    y: -4,
    duration: 2,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
  });
</script>
