---
import { cn } from "@/lib/utils";
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "../ui/accordion";

const { class: className, faqs } = Astro.props;
---
<div class={cn("", className)}>
  <div id="faq-accordion" class="h-150.5 overflow-hidden">
    <Accordion defaultValue={faqs[0]?.id} collapsible>
      {
        faqs.map((item: any, index: number) => (
          <AccordionItem
            value={item.id}
            class="accordion-item group lg:w-200  px-4 py-3.5 border-b border-[#301C1B]/10 last:border-b-0"
          >
            <AccordionTrigger class="accordion-trigger cursor-pointer  font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-[#301C1B]">
              {index + 1}. {item.question}
            </AccordionTrigger>

            <AccordionContent class="accordion-content pr-8 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-[#301C1B]/70">
              {item.answer}
            </AccordionContent>
          </AccordionItem>
        ))
      }
    </Accordion>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initFaqAnimation() {
    const accordion = document.querySelector("#faq-accordion");

    if (!accordion) return;

    // Scroll Trigger Animation
    gsap.from(accordion.querySelectorAll(".accordion-item"), {
      opacity: 0,
      y: 60,
      duration: 0.5,
      stagger: 0.08,
      ease: "power3.out",
      scrollTrigger: {
        trigger: accordion,
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
    });

    // First opened item animation
    requestAnimationFrame(() => {
      const firstOpen = accordion.querySelector(
        '.accordion-item[data-state="open"] .accordion-content',
      );

      if (firstOpen) {
        gsap.from(firstOpen, {
          opacity: 0,
          y: 20,

          ease: "power4.out",
        });
      }
    });

    // Click animation
    accordion.querySelectorAll(".accordion-trigger").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        requestAnimationFrame(() => {
          const item = trigger.closest(".accordion-item");

          if (item && item.getAttribute("data-state") === "open") {
            const content = item.querySelector(".accordion-content");

            gsap.fromTo(
              content,
              {
                opacity: 0,
                y: 20,
              },
              {
                opacity: 1,
                y: 0,
                duration: 0.45,
                ease: "power3.out",
              },
            );
          }
        });
      });
    });
  }

  document.addEventListener("astro:page-load", initFaqAnimation);

  initFaqAnimation();
</script>
