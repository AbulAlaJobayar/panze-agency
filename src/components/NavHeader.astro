---
import { cn } from "@/lib/utils";
import { Header, HeaderContainer, HeaderGroup } from "@/components/ui/header";
import { Logo, LogoImage } from "@/components/ui/logo";
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
  navigationMenuTriggerStyle,
} from "@/components/ui/navigation-menu";
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetTrigger,
} from "@/components/ui/sheet";
import navbgvector from "../assets/navbgvector.svg";
import { Icon } from "./ui/icon";
type Props = {
  class?: string;
  logo: {
    href: string;
    src: any;
    alt: string;
  };
  navigation: {
    label: string;
    href: string;
  }[];
};
import navrighticon from "../assets/navrighticon.svg";
import Container from "./ui/Container.astro";

const { class: className, logo, navigation } = Astro.props;
const pathname = Astro.url.pathname;
---

<Header class={cn("border-b-[0.5px] px-0", className)}>
  <Container>
    <HeaderContainer
      class="justify-between h-12 pl-2"
      style={`background-image: url(${navbgvector.src})`}
    >
      <HeaderGroup
        class={"  pr-12 w-47 text-center pl-6 py-3 border-r-[0.5px] bg-white"}
      >
        <!-- logo -->
        <Logo href={logo.href} id="logo">
          <LogoImage src={logo.src} alt={logo.alt} />
        </Logo>
      </HeaderGroup>
      <NavigationMenu
        class="absolute left-1/2 hidden max-w-none -translate-x-1/2 lg:flex mt-1.5"
        align="center"
      >
        <NavigationMenuList>
          {
            navigation.map((item, index) => (
              <NavigationMenuItem value={`nav-${index}`} id="nav-item">
                <NavigationMenuLink
                  href={item.href}
                  class={`nav-link ${navigationMenuTriggerStyle()} font-dm-mono font-normal text-[14px] leading-[150%] uppercase tracking-[-4%] ${
                    pathname === item.href
                      ? "text-[#E8704E]"
                      : "text-gray-900 hover:text-[#E8704E]"
                  }`}
                >
                  {item.label}
                </NavigationMenuLink>
              </NavigationMenuItem>
            ))
          }
        </NavigationMenuList>
      </NavigationMenu>

      <!-- right side -->
      <HeaderGroup id="contact" class="ml-auto hidden justify-end lg:flex">
        <NavigationMenuLink
          href="/contact"
          class="contact-btn relative overflow-hidden bg-primary w-51.75 text-center py-3 px-5 flex justify-center items-center gap-2 cursor-pointer rounded-none"
        >
          <span class="contact-btn-bg"></span>

          <img
            src={navrighticon.src}
            alt="icon"
            class="contact-btn-icon h-5 w-5 relative z-10"
          />

          <p class="text-white text-base font-dm-mono relative z-10">Contact</p>
        </NavigationMenuLink>
      </HeaderGroup>

      <Sheet class="lg:hidden pt-2 pr-4">
        <SheetTrigger
          variant="ghost"
          size="icon-sm"
          class="ml-auto"
          aria-label="Open menu"
        >
          <Icon name="menu" id={"#icon"} />
        </SheetTrigger>

        <SheetContent side="right" class="p-0">
          <div class="flex h-full flex-col gap-6 overflow-y-auto px-4 py-12">
            <nav aria-label="Main navigation" class="flex flex-col gap-4">
              {
                navigation.map((item) => (
                  <div class="grid gap-1">
                    <SheetClose
                      variant="ghost"
                      class="justify-start font-medium"
                    >
                      <NavigationMenuLink
                        href={item.href}
                        class={`${navigationMenuTriggerStyle()} font-dm-mono font-normal text-[14px] leading-[150%]    uppercase  tracking-[-4%]  ${
                          pathname === item.href
                            ? "text-[#E8704E] "
                            : "text-gray-900 hover:text-[#E8704E]"
                        }`}
                      >
                        {item.label}
                      </NavigationMenuLink>
                    </SheetClose>
                  </div>
                ))
              }
              <!-- Static Extra Item -->
              <div class="grid gap-1">
                <SheetClose variant="ghost" class="justify-start font-medium">
                  <NavigationMenuLink
                    href="/contact"
                    class={`${navigationMenuTriggerStyle()} font-dm-mono font-normal text-[14px] leading-[150%] uppercase tracking-[-4%] ${
                      pathname === "/case-studies"
                        ? "text-[#E8704E]"
                        : "text-gray-900 hover:text-[#E8704E]"
                    }`}
                  >
                    Contact
                  </NavigationMenuLink>
                </SheetClose>
              </div>
            </nav>
            <div class="mt-auto flex flex-col gap-2">
              <slot />
            </div>
          </div>
        </SheetContent>
      </Sheet>
    </HeaderContainer>
  </Container>
</Header>

<script>
  import gsap from "gsap";

  const button = document.querySelector(".contact-btn");
  const icon = document.querySelector(".contact-btn-icon");

  button?.addEventListener("mouseenter", () => {
    gsap.to(icon, {
      x: 6,
      rotate: 45,
      duration: 0.45,
      ease: "power3.out",
    });

    gsap.to(button, {
      y: 0,
      duration: 0.45,
      ease: "power3.out",
    });
  });

  button?.addEventListener("mouseleave", () => {
    gsap.to(icon, {
      x: 0,
      rotate: 0,
      duration: 0.45,
      ease: "power3.out",
    });

    gsap.to(button, {
      y: 0,
      duration: 0.45,
      ease: "power3.out",
    });
  });
  // NAV LINK HOVER

  document.querySelectorAll(".nav-link").forEach((link) => {
    link.addEventListener("mouseenter", () => {
      gsap.to(link, {
        y: 0,
        duration: 0.35,
        ease: "power3.out",
      });
    });

    link.addEventListener("mouseleave", () => {
      gsap.to(link, {
        y: 0,
        duration: 0.35,
        ease: "power3.out",
      });
    });
  });
</script>
<style>
  .nav-link {
    position: relative;
    transition:
      color 0.4s ease,
      transform 0.4s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 8px;

    height: 1px;
    background: #e8704e;

    transform: scaleX(0);
    transform-origin: right;

    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact-btn {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
</style>
