---
import * as data from "@/content/career/jobs-opening-content.md";
import LinkButton from "../ui/LinkButton.astro";
import Container from "../ui/Container.astro";
const { jobs } = data.frontmatter;

---

<Container>
<section class="bg-[#301C1B]   mt-16">
  <div class="grid grid-cols-1 lg:grid-cols-2">

    {
      jobs.map((job:any, index:any) => (
        <article class:list={["job-card border-[#F26C3A]",index === 0 && "lg:border-r",]}>
          <div
            class="flex h-full flex-col p-8  border-b lg:border-b-0 border-[#4B3736]" >
            <!-- Category -->
            <span class="job-category font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary" > {job.category}  </span>

            <!-- Title -->
            <h3  class="job-title mt-3  max-w-90 font-commissioner font-semibold text-[20px] leading-[150%] tracking-[-4%] uppercase text-white"> {job.title}  </h3>

            <!-- Description -->
            <p  class="job-description mt-3 mb-8 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-white/70" >  {job.description}  </p>

           <!-- button  --> 
          
             <LinkButton  href={job.applyLink}  text="Apply now"   class="job-cta  mt-auto "/>
          </div>
        </article>
      )) 
    }
 </div>
</section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".job-card",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  // Cards reveal
  tl.from(".job-card", {
    y: 80,
    opacity: 0,
    stagger: 0.08,
    ease: "power4.out",
  })

    // Category
    .from(
      ".job-category",
      {
        y: 20,
        opacity: 0,
        stagger: 0.08,
      },
      "-=0.6",
    )

    // Title
    .from(
      ".job-title",
      {
        y: 35,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.6",
    )

    // Description
    .from(
      ".job-description",
      {
        y: 25,
        opacity: 0,
        stagger: 0.08,
      },
      "-=0.6",
    )

    // CTA
    .from(
      ".job-cta",
      {
        y: 20,
        opacity: 0,
        scale: 0.95,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.6",
    );

</script>