---
import Container from "../ui/Container.astro";
import LinkButton from "../ui/LinkButton.astro";
import * as data from "@/content/career/career-hero-content.md";
const { title, description, cta, image } = data.frontmatter;
---

<!-- hero section -->
<div class="border-border lg:border-b">
  <Container>
    <div class="flex flex-col lg:flex-row">
      <!-- Left Content -->
      <div class="w-full shrink-0 border-b lg:w-100 lg:border-b-0 lg:border-r">
        <div class="flex h-full flex-col ml-8 mr-8.25 mt-25.25">
          <div>
            <h3
              class="career-title mb-14 font-commissioner text-[28px] font-semibold uppercase leading-[110%] tracking-[-4%] text-primary"
            >
              {title}
            </h3>

            <p
              class="career-description w-full font-dm-mono text-sm font-normal leading-[150%] tracking-[-4%]"
            >
              {description}
            </p>
          </div>
          <LinkButton
            href="/contact"
            text={cta}
            class="mt-67.25 mb-13 career-cta"
          />
        </div>
      </div>

      <!-- Right Gallery -->
      <div class="flex-1 px-21 py-27.75 overflow-hidden">
        <div class="mx-auto max-w-190">
          <!-- Mobile -->
          <div class="grid grid-cols-2 gap-5 lg:hidden">
            {
              image.map((img: string) => (
                <div class="border border-primary bg-[#F6DDD6] p-1">
                  <img src={img} class="aspect-4/5 w-full object-cover" />
                </div>
              ))
            }
          </div>

          <!-- Desktop -->
          <div class="hidden lg:grid grid-cols-3 items-center gap-x-2">
            <!-- Left -->
            <div class="flex justify-end">
              <div
                class="career-card card-1 border border-primary bg-[#F6DDD6] p-1"
              >
                <img src={image[0]} class="h-62.5 w-52.5 object-cover" />
              </div>
            </div>

            <!-- Center -->
            <div class="flex flex-col items-center gap-10">
              <div
                class="career-card card-2 border border-primary bg-[#F6DDD6] p-1"
              >
                <img src={image[1]} class="h-42.5 w-36.25 object-cover" />
              </div>

              <div
                class="career-card card-3 border border-primary bg-[#F6DDD6] p-1"
              >
                <img src={image[2]} class="h-47.5 w-41.25 object-cover" />
              </div>
            </div>

            <!-- Right -->
            <div class="flex justify-start">
              <div
                class="career-card card-4 border border-primary bg-[#F6DDD6] p-1"
              >
                <img src={image[3]} class="h-58.75 w-48.75 object-cover" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</div>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ===== Entrance Animation =====
  const heroTl = gsap.timeline({
    scrollTrigger: {
      trigger: ".career-title",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
  });

  heroTl
    .from(".career-title", {
      y: 120,
      opacity: 0,
      ease: "power4.out",
    })

    .from(
      ".career-description",
      {
        y: 40,
        opacity: 0,
        ease: "power4.out",
      },
      "-=0.4"
    )

    .from(
      ".career-cta",
      {
        y: 30,
        opacity: 0,
        scale: 0.9,
        ease: "power4.out",
      },
      "-=0.4",
    );
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: ".career-card",
      start: "top 90%",
    },
  });

  tl.from(".career-card", {
    y: 10,
    opacity: 0,
    rotate: gsap.utils.wrap([-3, 3]),
    scale: 0.8,
    stagger: 0.08,
    ease: "power4.out",
  });

  // ===== Floating Loop =====

  gsap.to(".card-1", {
    x: -0.1,
    rotate: 1,
    duration: 4,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
  });

  gsap.to(".card-2", {
    x: 0.1,
    rotate: -1,
    duration: 4,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
  });

  gsap.to(".card-3", {
    x: -0.1,
    rotate: 1,
    duration: 4,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
  });

  gsap.to(".card-4", {
    x: 0.1,
    rotate: -1,
    duration: 4,
    repeat: -1,
    yoyo: true,
    ease: "sine.inOut",
  });

  // ===== Mouse Parallax =====

  const gallery = document.querySelector(".max-w-190");

  gallery?.addEventListener("mousemove", (e: any) => {
    const rect = gallery.getBoundingClientRect();

    const x = (e.clientX - rect.left) / rect.width - 0.5;
    const y = (e.clientY - rect.top) / rect.height - 0.5;

    gsap.to(".card-1", {
      x: x * 20,
      y: y * 15,
      duration: 1,
    });

    gsap.to(".card-2", {
      x: x * -30,
      y: y * -20,
      duration: 1,
    });

    gsap.to(".card-3", {
      x: x * 40,
      y: y * 25,
      duration: 1,
    });

    gsap.to(".card-4", {
      x: x * -25,
      y: y * -15,
      duration: 1,
    });
  });

  gallery?.addEventListener("mouseleave", () => {
    gsap.to(".career-card", {
      x: 0,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
    });
  });

  // ===== Scroll Depth Effect =====

  gsap.to(".card-1", {
    yPercent: -20,
    scrollTrigger: {
      trigger: ".max-w-190",
      start: "top bottom",
      end: "bottom top",
      scrub: 1,
    },
  });

  gsap.to(".card-4", {
    yPercent: 20,
    scrollTrigger: {
      trigger: ".max-w-190",
      start: "top bottom",
      end: "bottom top",
      scrub: 1,
    },
  });
</script>
