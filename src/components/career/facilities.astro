---
import Container from "../ui/Container.astro";
import { Icon } from "../ui/icon";
import * as data from "@/content/career/facilities-content.md";

const { title, subtitle, description, benefits } = data.frontmatter;
---

<Container>
  <section id="career-facility-section">
    <div class="mx-auto">
      <!-- Header -->
      <div class="grid lg:grid-cols-[180px_490px_1fr] px-8 pt-26">
        <div>
          <span
            class="career-facility-label mt-8 lg:mt-0 flex items-center gap-2 font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary"
          >
            <Icon name="star" class="size-4" />
            {title}
          </span>
        </div>
        <h2
          class="career-facility-title mt-8 lg:mt-0 max-w-100 font-commissioner font-semibold text-[24px] leading-[110%] tracking-[-4%] uppercase"
        >
          {subtitle}
        </h2>

        <p
          class="carrer-facility-description mt-10 lg:mt-0 mb-16 justify-self-end font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%]"
        >
          {description}
        </p>
      </div>

      <!-- Benefits -->
      <div class="grid lg:grid-cols-2 px-8">
        {
          benefits.map((item: any, index: any) => (
            <div
              class:list={[
                "career-facility-card border-b border-black/20",
                index % 2 === 0 && "lg:border-r border-black/20",
              ]}
            >
              <div class="grid  lg:grid-cols-[180px_1fr] p-8 gap-8">
                <div>
                  <Icon
                    name={item.icon}
                    class="career-facility-icon mb-2 size-5 text-primary"
                  />

                  <h3 class="career-facility-card-title font-dm-mono font-medium text-[16px] leading-[150%] tracking-[-4%] text-primary">
                    {item.title}
                  </h3>
                </div>

                <p class="career-facility-card-description font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%]">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Container>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#career-facility-section",
      start: "top 90%",
      toggleActions: "play none none reverse",
    },
    defaults: {
      ease: "power4.out",
    },
  });

  tl
    // Label
    .from(".career-facility-label", {
      y: 100,
      opacity: 0,
    })

    // Title
    .from(
      ".career-facility-title",
      {
        y: 100,
        opacity: 0,
      },
      "-=0.7",
    )

    // Description
    .from(
      ".carrer-facility-description",
      {
        y: 40,
        opacity: 0,
      },
      "-=0.7",
    )

    // Cards
    .from(
      ".career-facility-card",
      {
        y: 70,
        opacity: 0,
        stagger: 0.08,
      },
      "-=0.7",
    )

    // Icons
    .from(
      ".career-facility-icon",
      {
        scale: 0,
        rotate: -180,
        opacity: 0,
        stagger: 0.08,
        ease: "power4.out",
      },
      "-=0.7",
    )

    // Card titles
    .from(
      ".career-facility-card-title",
      {
        y: 20,
        opacity: 0,
        stagger: 0.08,
      },
      "-=0.7",
    )

    // Card descriptions
    .from(
      ".career-facility-card-description",
      {
        y: 20,
        opacity: 0,
        stagger: 0.08,
      },
      "-=0.7",
    );

  // ==========================
  // Hover Lift Effect
  // ==========================

  document.querySelectorAll(".facility-card").forEach((card) => {
    card.addEventListener("mouseenter", () => {
      gsap.to(card, {
        y: -8,
        ease: "power4.out",
      });
    });

    card.addEventListener("mouseleave", () => {
      gsap.to(card, {
        y: 0,
        ease: "power4.out",
      });
    });
  });

  // ==========================
  // Floating Icons
  // ==========================

  gsap.to(".facility-icon", {
    y: -4,
    duration: 2,
    repeat: -1,
    yoyo: true,
    stagger: 0.1,
    ease: "sine.inOut",
  });

  // ==========================
  // Scroll Depth Effect
  // ==========================

  gsap.to(".facility-card:nth-child(odd)", {
    yPercent: -6,
    ease: "none",
    scrollTrigger: {
      trigger: ".facility-section",
      start: "top bottom",
      end: "bottom top",
      scrub: 1,
    },
  });

  gsap.to(".facility-card:nth-child(even)", {
    yPercent: 6,
    ease: "none",
    scrollTrigger: {
      trigger: ".facility-section",
      start: "top bottom",
      end: "bottom top",
      scrub: 1,
    },
  });
</script>
