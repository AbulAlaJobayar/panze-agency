---
import { Image } from "astro:assets";

import * as contactData from "@/content/contact-content.md";
import pattern from "@/assets/background/ceobg.png";
import meet from "@/assets/linkicon/meet.svg";
import contactIcon from "@/assets/sectionIcon/contact-section.svg";
import whatappIcon from "@/assets/linkicon/whatsapp.svg";
import { NavigationMenuLink } from "../ui/navigation-menu";
import PanzeContactForm from "./PanzeContactForm";
import LinkButton from "../ui/LinkButton.astro";
import Container from "../ui/Container.astro";

const contactUrl = import.meta.env.CONTACT_URL;
const whatsappUrl = import.meta.env.WHATSAPP_URL;
const { name, designation, ceoImage, title, meetDescription } =
  contactData.frontmatter;
---

<section id="contact-section" class="bg-[#1E1212] overflow-hidden">
  <div>
    <!-- top side -->
    <div class="border-b border-white/20">
      <Container>
        <div
          class="contact-badge px-8 pt-10 lg:pt-26 lg:pb-16.75 flex flex-col lg:flex-row items-center"
        >
          <!-- Left: Icon + Title -->
          <div class="contact-title mb-6 lg:mb-0 w-full lg:w-[15%]">
            <div class="flex items-center gap-2">
              <img
                src={contactIcon.src}
                alt="Latest icon"
                class="w-4 h-5 md:w-auto md:h-auto contact-section-icon"
              />
              <h6
                class="font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-primary contact-section-title"
              >
                {title}
              </h6>
            </div>
          </div>

          <!-- Middle: SubTitle -->
          <div class="contact-description mb-8 lg:mb-0 w-full lg:w-[24%]">
            <p
              class="text-white font-commissioner font-semibold px-1 text-[25px] sm:text-[22px] md:text-[24px] leading-[110%] tracking-[-4%] uppercase"
            >
              <span class="hidden lg:block"
                >Got an idea?<br /> Let's make it real.</span
              >
              <span class="block lg:hidden"
                >Got an idea? Let's make it real.</span
              >
            </p>
          </div>

          <!-- Right: Description -->
          <div
            class="contact-description mb-10 lg:mb-0 w-full lg:w-[50%] ml-auto"
          >
            <p
              class="font-dm-mono font-normal text-[14px] leading-[150%] tracking-[-4%] text-white"
            >
              <span class="hidden lg:block">
                No pitch decks. No jargon. Just a conversation about what <br /> you're
                building, and how we can help.</span
              >
              <span class="block lg:hidden">
                No pitch decks. No jargon. Just a conversation about what you're
                building, and how we can help.</span
              >
            </p>
          </div>
        </div>
      </Container>
    </div>

    <!-- bottom side -->
    <Container>
      <div
        class=".contact-profile flex flex-col lg:flex-row items-stretch border-white/20"
      >
        <!-- Left Side - Fixed width with white background -->

        <div
          class="w-full lg:w-116 shrink-0 border-b lg:border-b-0 lg:border-r p border-white/20 pb-26"
        >
          <div class="mx-auto w-fit">
            <div class="w-[288px] mt-16 border border-white/20">
              {/* Image */}
              <div
                class="contact-profile relative overflow-hidden bg-[radial-gradient(circle,rgba(249,115,22,0.15)_1px,transparent_1px)] bg-size-[12px_12px] sm:bg-size-[14px_14px] lg:bg-size-[16px_16px]"
                style={`background-image: url(${pattern.src}); background-size: cover;`}
              >
                <Image
                  src={ceoImage}
                  alt={name}
                  width={400}
                  height={500}
                  class="contact-image w-full max-h-80 object-cover object-top transition-transform duration-500 hover:scale-105"
                />
              </div>

              {/* Content */}
              <div
                class="contact-badge
            pl-8 py-5 border-t border-white/20"
              >
                <h3
                  class="contact-title text-white font-dm-mono text-[18px] leading-[150%] font-medium tracking-[-4%]"
                >
                  {name}
                </h3>

                <p
                  class="contact-description text-white font-dm-mono text-[14px] leading-[150%] font-normal tracking-[-4%]"
                >
                  {designation}
                </p>
              </div>
            </div>
            <!-- left bottom side -->
            <div class="bg-white w-[288px]">
              <div class="contact-badge ml-8 py-8">
                <img
                  src={meet.src}
                  alt="Google Meet"
                  class="contact-title mb-7"
                />
                <h1 class="text-primary contact-description">
                  {meetDescription}
                </h1>
                <div
                  class="contact-description flex items-center gap-3 mt-24.25"
                >
                  <LinkButton href={contactUrl} text="Shedule call" />
                  <NavigationMenuLink href={whatsappUrl} class="hover:scale-3d">
                    <img src={whatappIcon.src} alt="icon" />
                  </NavigationMenuLink>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side - Background image ONLY on right side -->
        <div class="contact-form-wrapper mt-16 lg:ml-16 pb:10 lg:pb-0">
          <PanzeContactForm client:load />
        </div>
      </div>
    </Container>
  </div>
</section>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: "#contact-section",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });

  // ======================
  // HEADER
  // ======================

  tl.from(".contact-section-icon", {
    opacity: 0,
    rotate: -90,
    ease: "power4.out",
  })
    .from(
      ".contact-section-title",
      {
        opacity: 0,
        x: -20,
        ease: "power4.out",
      },
      "+=0.4",
    )

    .from(
      ".contact-description",
      {
        opacity: 0,
        y: 40,
        ease: "power4.out",
      },
      "-=0.3",
    );

  // ======================
  // CEO IMAGE REVEAL
  // ======================

  tl.from(
    ".contact-profile img",
    {
      scale: 1.25,
      opacity: 0,
      filter: "blur(15px)",
      clipPath: "inset(100% 0 0 0)",
      ease: "expo.out",
    },
    "-=0.7",
  );

  // ======================
  // CEO INFO
  // ======================

  tl.from(
    ".contact-profile + div .contact-badge",
    {
      opacity: 0,
      x: -40,
      ease: "power4.out",
    },
    "-=1",
  );

  // CEO Card Hover 3D
  document.querySelectorAll(".contact-profile").forEach((card) => {
    const image = card.querySelector("img");

    card.addEventListener("mousemove", (e: any) => {
      const rect = card.getBoundingClientRect();

      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const rotateY = (x / rect.width - 0.5) * 12;
      const rotateX = (y / rect.height - 0.5) * -12;

      // Card Tilt
      gsap.to(card, {
        rotateX,
        rotateY,
        transformPerspective: 1200,
        duration: 0.5,
        ease: "power3.out",
      });

      // Image Depth
      gsap.to(image, {
        x: rotateY * 3,
        y: rotateX * -3,
        scale: 1,
        duration: 0.5,
        ease: "power3.out",
      });
    });

    card.addEventListener("mouseleave", () => {
      gsap.to(card, {
        rotateX: 0,
        rotateY: 0,
        duration: 0.8,
        ease: "expo.out",
      });

      gsap.to(image, {
        x: 0,
        y: 0,
        scale: 1,
        duration: 0.8,
        ease: "expo.out",
      });
    });
  });
</script>
<style>
  .contact-profile {
    transform-style: preserve-3d;
    transform-origin: center center;
    will-change: transform;
  }

  .contact-profile img {
    will-change: transform;
    backface-visibility: hidden;
  }
</style>
